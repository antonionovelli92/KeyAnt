@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+import android.content.Context;
+/** A pair is a two-pointer chord, in either order. Ordinary taps remain native. */
+public final class KeyPairGesture669 {
+ public static boolean matches(Context c,int a,int b){
+  if(!KeyAntPrefs.bool(c,"pair_gesture",false))return false;
+  String left=KeyAntPrefs.text(c,"pair_first","q"),right=KeyAntPrefs.text(c,"pair_second","p");
+  if(left.length()!=1||right.length()!=1||left.equalsIgnoreCase(right))return false;
+  int x=Character.toLowerCase(left.charAt(0)),y=Character.toLowerCase(right.charAt(0));
+  a=Character.toLowerCase(a);b=Character.toLowerCase(b);return a==x&&b==y||a==y&&b==x;
+ }
+ public static String action(Context c,String direction){return KeyAntPrefs.text(c,"pair_"+direction,direction.equals("up")?"toolbar_show":direction.equals("down")?"toolbar_hide":"none");}
+}
