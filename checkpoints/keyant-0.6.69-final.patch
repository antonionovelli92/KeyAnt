+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma
+import androidx.compose.runtime.Composable
+@Composable internal fun KeyPairSettings669(){
+ StudioCard{
+  Toggle("Gesti da una coppia di tasti","pair_gesture",false,"Due dita insieme, una su ciascun tasto: solo questa coppia usa le azioni qui sotto. I tocchi normali continuano a scrivere.")
+  val keys=('a'..'z').map{it.toString() to it.uppercase()}
+  Choice("Primo tasto della coppia","pair_first","q",keys)
+  Choice("Secondo tasto della coppia","pair_second","p",keys)
+  val actions=listOf("none" to "Nessuna azione","toolbar_show" to "Mostra barra icone","toolbar_hide" to "Nascondi barra icone","select_all" to "Seleziona tutto","copy" to "Copia","cut" to "Taglia","paste" to "Incolla","undo" to "Annulla","redo" to "Ripristina","clipboard" to "Apri appunti","emoji" to "Apri emoji","voice" to "Dettatura")
+  Choice("Coppia · verso l’alto","pair_up","toolbar_show",actions)
+  Choice("Coppia · verso il basso","pair_down","toolbar_hide",actions)
+  Choice("Coppia · verso sinistra","pair_left","none",actions)
+  Choice("Coppia · verso destra","pair_right","none",actions)
+  Note("Scegli due lettere diverse. Q + P è la coppia iniziale. Suggerimenti, pillole e riempimento automatico restano prioritari. Dopo la scrittura la barra torna alla modalità scelta.")
+ }
+}
