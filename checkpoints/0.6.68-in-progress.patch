+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+import android.content.Context;import android.graphics.*;import android.view.View;
+/** Isolated gesture demonstration; never sends input or changes a preference. */
+public final class GesturePreview668 extends View {
+ private final Paint paint=new Paint(3);private String mode="hold";private boolean numbers;private long start;
+ public GesturePreview668(Context c){super(c);setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);}
+ public void configure(String key,String value){mode=value;numbers=key.equals("numbers_gesture");start=android.os.SystemClock.uptimeMillis();invalidate();}
+ @Override protected void onDraw(Canvas canvas){
+  float scale=getWidth()/112f;canvas.save();canvas.scale(scale,scale);long elapsed=(android.os.SystemClock.uptimeMillis()-start)%2400;
+  float wait=mode.equals("hold")?650:200;float t=Math.max(0,Math.min(1,(elapsed-wait)/950));float fraction=t*t*(3-2*t);float distance=32*fraction*(numbers?-1:1);
+  paint.setColor(0xff202936);canvas.drawRoundRect(2,6,110,66,8,8,paint);
+  int save=canvas.save();canvas.clipRect(4,8,108,64);
+  paint.setColor(0xff345571);float x=numbers?108-32*fraction:4;canvas.drawRoundRect(x,22,x+32*fraction,62,4,4,paint);
+  paint.setColor(0xffc3d1df);for(int row=0;row<3;row++)for(int col=0;col<7;col++){float k=8+col*14+distance;canvas.drawRoundRect(k,24+row*12,k+10,33+row*12,2,2,paint);}canvas.restoreToCount(save);
+  float origin=numbers?97:14,y=mode.equals("toolbar")?15:56;
+  paint.setColor(0xff81c8ff);canvas.drawCircle(origin+distance,y,5,paint);paint.setStyle(Paint.Style.STROKE);paint.setStrokeWidth(1.5f);canvas.drawCircle(origin+distance,y,8,paint);paint.setStyle(Paint.Style.FILL);
+  canvas.restore();if(isAttachedToWindow()&&isShown()&&android.animation.ValueAnimator.areAnimatorsEnabled())postInvalidateDelayed(33);
+ }
+}
