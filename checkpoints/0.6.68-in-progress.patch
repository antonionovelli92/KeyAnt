+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+import android.animation.ValueAnimator;
+import android.view.View;
+/** The launch icon gives its space to the pill; cancellation restores the current context. */
+public final class IconPillBridge668 {
+ private final View icon;private int width;private boolean collapsed;private ValueAnimator animator;
+ public IconPillBridge668(View icon){this.icon=icon;}
+ public void expanded(boolean expanded){
+  if(width==0){width=icon.getLayoutParams().width;if(width<=0)width=Math.max(icon.getWidth(),Math.round(44*icon.getResources().getDisplayMetrics().density));}
+  if(collapsed==expanded)return;collapsed=expanded;
+  if(animator!=null)animator.cancel();
+  icon.setEnabled(!expanded);icon.setImportantForAccessibility(expanded?View.IMPORTANT_FOR_ACCESSIBILITY_NO:View.IMPORTANT_FOR_ACCESSIBILITY_AUTO);
+  int from=Math.max(0,icon.getLayoutParams().width),to=expanded?0:width;
+  if(!icon.isAttachedToWindow()||!ValueAnimator.areAnimatorsEnabled()||!KeyAntPrefs.bool(icon.getContext(),"pill_motion",true)){position(to);return;}
+  animator=ValueAnimator.ofInt(from,to);animator.setDuration(280);animator.setInterpolator(new android.view.animation.PathInterpolator(.22f,1,.36f,1));animator.addUpdateListener(a->position((int)a.getAnimatedValue()));animator.start();
+ }
+ private void position(int w){var params=icon.getLayoutParams();params.width=w;icon.setLayoutParams(params);float fraction=w/(float)Math.max(1,width);icon.setAlpha(fraction);icon.setScaleX((icon.getScaleX()<0?-1:1)*(.7f+.3f*fraction));icon.setScaleY(.7f+.3f*fraction);}
+ public void reset(){if(animator!=null)animator.cancel();collapsed=false;if(width>0)position(width);icon.setEnabled(true);icon.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_AUTO);}
+}
