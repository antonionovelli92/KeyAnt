+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+import android.graphics.Rect;
+import android.view.View;
+import android.view.ViewGroup;
+/** Locate the actual visible edge command, including custom tools and alternative bar layouts. */
+public final class ToolbarEdges668 {
+ private ToolbarEdges668(){}
+ public static boolean hit(View root,float screenX,float screenY,boolean left){
+  Rect edge=new Rect();find(root,left,edge);
+  return !edge.isEmpty()&&edge.contains((int)screenX,(int)screenY);
+ }
+ private static void find(View view,boolean left,Rect edge){
+  if(view.getVisibility()!=View.VISIBLE||view.getAlpha()<.2f)return;
+  if(view.isClickable()&&view.isEnabled()&&view.getContentDescription()!=null){
+   Rect visible=new Rect();
+   if(view.getGlobalVisibleRect(visible)&&visible.width()>=Math.min(view.getWidth()*.5f,24*view.getResources().getDisplayMetrics().density)&&
+       (edge.isEmpty()||(left?visible.centerX()<edge.centerX():visible.centerX()>edge.centerX())))edge.set(visible);
+   return;
+  }
+  if(view instanceof ViewGroup group)for(int i=0;i<group.getChildCount();i++)find(group.getChildAt(i),left,edge);
+ }
+}
