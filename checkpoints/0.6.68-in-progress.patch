+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+import android.graphics.*;import android.graphics.drawable.Drawable;
+/** Theme-coloured dial engraving, with four tool sockets instead of a settings cog. */
+public final class ToolDial668 extends Drawable {
+ private final Paint p=new Paint(3);private final int ink;private int alpha=255;
+ public ToolDial668(int ink){this.ink=ink;}
+ @Override public void draw(Canvas c){float w=getBounds().width(),h=getBounds().height(),r=Math.min(w,h)*.45f;int save=c.save();c.translate(getBounds().exactCenterX(),getBounds().exactCenterY());p.setColor(ink);p.setAlpha(Color.alpha(ink)*alpha/255);p.setStyle(Paint.Style.STROKE);p.setStrokeWidth(Math.max(1,r*.055f));for(int i=0;i<12;i++){double a=i*Math.PI/6;float x=(float)Math.cos(a),y=(float)Math.sin(a);c.drawLine(x*r*.88f,y*r*.88f,x*r,y*r,p);}p.setStyle(Paint.Style.FILL);float b=r*.24f;for(int x:new int[]{-1,1})for(int y:new int[]{-1,1})c.drawRoundRect(x*r*.34f-b,y*r*.34f-b,x*r*.34f+b,y*r*.34f+b,b*.55f,b*.55f,p);c.restoreToCount(save);}
+ @Override public void setAlpha(int alpha){this.alpha=alpha;invalidateSelf();}
+ @Override public void setColorFilter(ColorFilter filter){p.setColorFilter(filter);invalidateSelf();}
+ @Override public int getOpacity(){return PixelFormat.TRANSLUCENT;}
+}
