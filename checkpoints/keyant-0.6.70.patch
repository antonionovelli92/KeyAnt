+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+import android.content.Context;import android.view.View;import android.widget.HorizontalScrollView;
+/** Measure the shell in the actual viewport on every attach/resize, never after layout. */
+public final class ToolbarViewport670 extends HorizontalScrollView {
+ private boolean bounded;private int available;
+ public ToolbarViewport670(Context c){super(c);}
+ public void boundShell(){bounded=true;requestLayout();}
+ @Override protected void onMeasure(int w,int h){available=Math.max(0,MeasureSpec.getSize(w)-getPaddingLeft()-getPaddingRight());super.onMeasure(w,h);}
+ @Override protected void measureChild(View child,int w,int h){if(bounded)child.measure(MeasureSpec.makeMeasureSpec(available,MeasureSpec.EXACTLY),getChildMeasureSpec(h,getPaddingTop()+getPaddingBottom(),child.getLayoutParams().height));else super.measureChild(child,w,h);}
+ @Override protected void measureChildWithMargins(View child,int w,int used,int h,int usedH){if(bounded)measureChild(child,w,h);else super.measureChildWithMargins(child,w,used,h,usedH);}
+}
