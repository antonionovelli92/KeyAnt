+ p.setStyle(Paint.Style.FILL);p.setColor(0x55000000);p.setAlpha(alpha/3);c.drawCircle(0,r*.09f,r,p);p.setAlpha(alpha);
+ p.setShader(new LinearGradient(-r,-r,r,r,new int[]{ToolSurface.mix(back,ink,.65f),back,ToolSurface.mix(back,ink,.4f)},null,Shader.TileMode.CLAMP));c.drawCircle(0,0,r*.94f,p);p.setShader(null);
+ p.setStrokeWidth(Math.max(.7f,r*.025f));for(int i=0;i<40;i++){double a=i*Math.PI/20;float x=(float)Math.cos(a),y=(float)Math.sin(a);p.setColor(i%2==0?ToolSurface.mix(back,ink,.7f):back);c.drawLine(x*r*.81f,y*r*.81f,x*r*.94f,y*r*.94f,p);}
+ p.setShader(new LinearGradient(0,-r,0,r,ToolSurface.mix(back,ink,.23f),ToolSurface.mix(back,Color.BLACK,.28f),Shader.TileMode.CLAMP));c.drawCircle(0,0,r*.78f,p);p.setShader(null);p.setStyle(Paint.Style.STROKE);p.setStrokeWidth(r*.025f);p.setColor(ToolSurface.mix(back,ink,.32f));c.drawCircle(0,0,r*.76f,p);
+ p.setStrokeCap(Paint.Cap.ROUND);p.setStrokeWidth(r*.09f);p.setColor(ink);c.drawLine(0,-r*.60f,0,-r*.34f,p);p.setStyle(Paint.Style.FILL);p.setColor(ToolSurface.mix(back,ink,.35f));c.drawCircle(0,0,r*.09f,p);c.restoreToCount(s);}
