+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+import android.os.*;import android.view.inputmethod.*;import helium314.keyboard.latin.utils.InputTypeUtils;
+/** One local replacement, memory-only, bounded, expiring and bound to the exact editor snapshot. */
+public final class SelectionUndo670 {
+ public record Shot(String text,int offset,int start,int end){}
+ private InputConnection owner;private EditorInfo editor;private Shot before,after;private int from;private String removed,inserted;private boolean undone;
+ private final Handler handler=new Handler(Looper.getMainLooper());private final Runnable expiry=this::clear;
+ public void clear(){handler.removeCallbacks(expiry);owner=null;editor=null;before=after=null;removed=inserted=null;undone=false;}
+ static Shot read(InputConnection ic){if(ic==null)return null;ExtractedTextRequest request=new ExtractedTextRequest();request.hintMaxChars=65536;request.hintMaxLines=4096;ExtractedText e=ic.getExtractedText(request,0);if(e==null||e.text==null||e.text.length()>65536||e.partialStartOffset>=0)return null;return new Shot(e.text.toString(),e.startOffset,e.selectionStart,e.selectionEnd);}
+ public Shot begin(InputConnection ic,EditorInfo info){clear();if(info==null||InputTypeUtils.isPasswordInputType(info.inputType))return null;Shot s=read(ic);if(s==null||s.start==s.end||Math.min(s.start,s.end)<0||Math.max(s.start,s.end)>s.text.length())return null;owner=ic;editor=info;return s;}
+ public void finish(InputConnection ic,EditorInfo info,Shot old){if(old==null||ic!=owner||info!=editor)return;Shot now=read(ic);if(now==null||now.offset!=old.offset){clear();return;}int lo=Math.min(old.start,old.end),hi=Math.max(old.start,old.end);String left=old.text.substring(0,lo),right=old.text.substring(hi);
+ if(now.text.equals(old.text)||!now.text.startsWith(left)||!now.text.endsWith(right)||now.text.length()<left.length()+right.length()){clear();return;}
+ before=old;after=now;from=lo+old.offset;removed=old.text.substring(lo,hi);inserted=now.text.substring(lo,now.text.length()-right.length());handler.postDelayed(expiry,120000);
+ }
+ public int selectionStart(){Shot s=undone?before:after;return s==null?-1:s.offset+s.start;}
+ public int selectionEnd(){Shot s=undone?before:after;return s==null?-1:s.offset+s.end;}
+ public boolean apply(InputConnection ic,EditorInfo info,boolean redo){if(owner!=ic||editor!=info||before==null||undone!=redo)return false;Shot expected=redo?before:after,current=read(ic);if(current==null||current.offset!=expected.offset||!current.text.equals(expected.text)){clear();return false;}
+ String replace=redo?removed:inserted,value=redo?inserted:removed;ic.beginBatchEdit();boolean ok=false;try{ic.finishComposingText();if(ic.setSelection(from,from+replace.length())){ok=ic.commitText(value,1);if(ok){Shot target=redo?after:before;ic.setSelection(target.offset+target.start,target.offset+target.end);}}}finally{ic.endBatchEdit();}if(!ok){clear();return false;}undone=!redo;return true;
+ }
+}
