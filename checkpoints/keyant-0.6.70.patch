+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+import java.util.*;
+/** Curated offline proper names / specialist terms. Explicit suggestions only; never diagnoses. */
+public final class SpecialistWords670 {
+ private static final String[] WORDS=("""
+Alzheimer Parkinson Asperger Tourette Hashimoto Crohn Sjögren Raynaud Ménière Hodgkin endometriosi fibromialgia ipotiroidismo ipertiroidismo sclerosi psoriasi dislessia discalculia emicrania osteoporosi artrite artrosi celiachia diabete ipertensione
+Einstein Newton Galileo Galilei Tesla Darwin Curie Turing Feynman Hawking Schrödinger Heisenberg Planck Bohr Faraday Maxwell Keplero Copernico Fibonacci Pitagora Archimede Ippocrate Aristotele Platone Socrate Nietzsche Schopenhauer Dostoevskij Tolstoj Kafka Shakespeare Tolkien Asimov Lovecraft Stephen Spielberg Scorsese Tarantino Nolan Kubrick Miyazaki Kurosawa DiCaprio McConaughey Johansson Schwarzenegger Stallone Streep Zendaya Chalamet Beyoncé
+Naruto Sasuke Kakashi Sharingan Rinnegan Mangekyō Hinata Kageyama Karasuno Haikyuu Luffy Zoro Sanji Takemichi Mikey Draken Goku Vegeta Gohan Frieza Gojo Sukuna Itadori Tanjiro Nezuko Inosuke Alakazam Pikachu Charizard Bulbasaur Squirtle Eevee Mewtwo Snorlax Pokémon
+JavaScript TypeScript Kotlin Kubernetes PostgreSQL SQLite GraphQL OAuth WebSocket cybersecurity autenticazione crittografia asincrono idempotenza serializzazione deserializzazione refactoring middleware frontend backend repository pull request
+""").split("\\s+");
+ public static List<String> suggest(String typed){if(typed==null||typed.length()<3||typed.length()>40||!typed.codePoints().allMatch(Character::isLetter))return List.of();String q=typed.toLowerCase(Locale.ROOT);Map<String,Double> scores=new HashMap<>();
+ for(String word:WORDS){String w=word.toLowerCase(Locale.ROOT);if(w.equals(q))continue;if(w.startsWith(q)){scores.put(word,0.0);continue;}if(q.length()<4||!q.substring(0,2).equals(w.substring(0,2)))continue;double best=9;for(int n=Math.max(3,q.length()-1);n<=Math.min(w.length(),q.length()+1);n++)best=Math.min(best,AdaptiveTyping.distance(q,w.substring(0,n)));if(best<=1.05)scores.put(word,1+best);}
+ return scores.keySet().stream().sorted(Comparator.<String>comparingDouble(scores::get).thenComparingInt(String::length).thenComparing(x->x)).limit(2).collect(java.util.stream.Collectors.toList());}
+}
