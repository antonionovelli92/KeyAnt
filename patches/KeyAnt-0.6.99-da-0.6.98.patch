@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+import java.util.regex.*;
+/** Optional deterministic repairs, only an explicit numeric/time correction, always previewed. */
+public final class VoiceRepairs699 {
+ private static final String VALUE="(?:[0-9]+(?::[0-9]{2}|[.,][0-9]+)?|zero|uno|due|tre|quattro|cinque|sei|sette|otto|nove|dieci|undici|dodici|tredici|quattordici|quindici|sedici|diciassette|diciotto|diciannove|venti)";
+ private static final Pattern REPAIR=Pattern.compile("(?iu)(?<![\\p{L}\\p{N}_:.+-])("+VALUE+")[ ,]+(?:anzi|volevo dire|scusa intendevo)[ ,]+("+VALUE+")(?![\\p{L}\\p{N}_:.])".replace("\\\\","\\"));
+ private static final Pattern QUOTES=Pattern.compile("\"[^\"]*\"|«[^»]*»|“[^”]*”");
+ public static String apply(String text){StringBuilder out=new StringBuilder();Matcher quotes=QUOTES.matcher(text);int end=0;while(quotes.find()){out.append(fragment(text.substring(end,quotes.start()))).append(quotes.group());end=quotes.end();}return out.append(fragment(text.substring(end))).toString();}
+ private static String fragment(String text){return REPAIR.matcher(text).replaceAll("$2");}
+}
