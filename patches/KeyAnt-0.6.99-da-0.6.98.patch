+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma
+import android.content.Context
+internal object AntControls699 {
+ val entries=listOf(
+  SettingResult("panel_appearance","Jolly del tastierino numerico","tasto giallo vuoto doppio tocco copia incolla seleziona tutto pressione lunga"),
+  SettingResult("bars","Aspetto del pannello ⋯","superficie strumenti coordinati tema meccanico stock anteprima"),
+  SettingResult("themes","Colori personali degli altri tasti","punto virgola colore default personalizzato lettere"),
+  SettingResult("size","Riga inferiore e tastierino","spaziatrice larghezza ridistribuire emoji appunti ordine"),
+  SettingResult("size","Salva il mio assetto","ripristina annulla dimensioni profili sezione"),
+  SettingResult("voice","Ripensamenti numerici espliciti","dettatura anzi volevo dire esitazioni Yaps Gboard")
+ )
+ fun guide(q:String):AntGuide.Answer?=when{
+  Regex("jolly|tasto giallo|tasto vuoto").containsMatchIn(q)->AntGuide.Answer("Il jolly del tastierino numerico seleziona tutto con due tocchi rapidi; un tocco copia la selezione, tenendolo premuto incolli. Puoi cambiare ogni gesto: «imposta il doppio tocco del jolly su incolla». Non cambia la spaziatrice delle lettere.",listOf(entries[0]))
