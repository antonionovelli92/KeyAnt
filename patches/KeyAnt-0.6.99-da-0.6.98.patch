@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma
+import android.content.Context
+import helium314.keyboard.keyboard.Key
+import helium314.keyboard.keyboard.KeyboardId
+import helium314.keyboard.keyboard.internal.KeyboardParams
+import helium314.keyboard.keyboard.internal.keyboard_parser.floris.KeyCode
+/** Runs before absolute hit rectangles and split geometry; total row width is invariant. */
+object BottomLayout699 {
+ @JvmStatic fun apply(c:Context,rows:List<ArrayList<Key.KeyParams>>,p:KeyboardParams){
+  val profile=p.mSizingProfile?:DimensionLayers699.profile(DimensionProfiles697.current(c),p.mId.mElementId)
+  if(p.mId.isNumberLayout){
+   if(DimensionLayers699.text(c,profile,"numeric_order","phone")=="calculator"){
+    rows.flatten().forEach{k->if(k.mCode in 49..51||k.mCode in 55..57){val code=if(k.mCode<55)k.mCode+6 else k.mCode-6;val row=rows.first{it.contains(k)};val i=row.indexOf(k);row[i]=Key.KeyParams(code.toChar().toString(),code,p,k.mWidth,0,k.mBackgroundType,null).also{it.mHeight=k.mHeight}}}
+   };return
+  }
+  if(!p.mId.isAlphaOrSymbolKeyboard)return
+  val row=rows.lastOrNull()?:return
+  val space=row.firstOrNull{it.mCode==32}?:return
+  val total=row.sumOf{it.mWidth.toDouble()}.toFloat()
+  val extras=DimensionLayers699.text(c,profile,"bottom_extras","").split(',').filter{it in setOf("emoji","clipboard")}.distinct()
+  for(extra in extras){val code=if(extra=="emoji")KeyCode.EMOJI else KeyCode.CLIPBOARD;if(row.any{it.mCode==code})continue
+   val k=Key.KeyParams(if(extra=="emoji")"!icon/emoji_normal_key" else "!icon/clipboard_normal_key",code,p,.09f,0,Key.BACKGROUND_TYPE_FUNCTIONAL,null);k.mHeight=space.mHeight
+   row.add(if(extra=="emoji")row.indexOf(space) else (row.indexOfFirst{it.mCode==10}.takeIf{it>=0}?:row.size),k)
+  }
+  val savedOrder=DimensionLayers699.text(c,profile,"bottom_order","").split(',').mapNotNull{it.toIntOrNull()}
+  if(savedOrder.isNotEmpty()){val ranked=savedOrder.withIndex().associate{it.value to it.index};row.sortBy{ranked[it.mCode]?:Int.MAX_VALUE}}
+  val percent=DimensionProfiles697.value(c,profile,"space_share",100).coerceIn(50,160)
+  if(percent==100&&extras.isEmpty())return
+  val desired=(space.mWidth*percent/100f).coerceIn(total*.18f,total*.65f)
+  val rest=row.filter{it!==space};val sum=rest.sumOf{it.mWidth.toDouble()}.toFloat()
+  if(sum<=0)return
+  space.mWidth=desired;rest.forEach{it.mWidth=it.mWidth*(total-desired)/sum}
+ }
+}
