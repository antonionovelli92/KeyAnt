+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma
+import androidx.compose.runtime.*
+import androidx.compose.foundation.layout.*
+import androidx.compose.material3.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalContext
+import helium314.keyboard.keyboard.internal.keyboard_parser.floris.KeyCode
+@Composable internal fun BottomOrder699(profile:String,revision:Int,reload:()->Unit){
+ val c=LocalContext.current;val p=KeyAntPrefs.get(c)
+ val defaults=listOf(KeyCode.SYMBOL_ALPHA,44,KeyCode.EMOJI,32,46,KeyCode.CLIPBOARD,10)
+ val order=remember(profile,revision){DimensionLayers699.text(c,profile,"bottom_order","").split(',').mapNotNull{it.toIntOrNull()}.takeIf{it.isNotEmpty()}?:defaults}
+ fun label(code:Int)=when(code){32->"Spazio";44->"Virgola";46->"Punto";10->"Invio";KeyCode.EMOJI->"Emoji";KeyCode.CLIPBOARD->"Appunti";else->"?123"}
+ Text("Ordine della riga · si spostano solo i tasti presenti",style=MaterialTheme.typography.labelLarge)
+ order.forEachIndexed{i,code->Row(Modifier.fillMaxWidth(),verticalAlignment=androidx.compose.ui.Alignment.CenterVertically){Text(label(code),Modifier.weight(1f));TextButton(enabled=i>0,onClick={val next=order.toMutableList();java.util.Collections.swap(next,i,i-1);p.edit().putString(DimensionProfiles697.key(profile,"bottom_order"),next.joinToString(",")).apply();reload()}){Text("←")};TextButton(enabled=i<order.lastIndex,onClick={val next=order.toMutableList();java.util.Collections.swap(next,i,i+1);p.edit().putString(DimensionProfiles697.key(profile,"bottom_order"),next.joinToString(",")).apply();reload()}){Text("→")}}}
+}
