+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+import android.content.Context;
+import android.graphics.*;
+import android.graphics.drawable.Drawable;
+/** Entire tool tile uses the catalogue cap renderer. No duplicated material approximations. */
+public final class ToolMenuSurface699 extends Drawable {
+ private final ThemeCatalog.Caps caps=new ThemeCatalog.Caps();
+ private final String theme;private final boolean dark;private float press;private android.animation.ValueAnimator motion;
+ public static String theme(Context c){String mode=KeyAntPrefs.text(c,"tools_surface","stock");return mode.equals("follow")?SearchTheme.active(c):mode.equals("custom")?KeyAntPrefs.text(c,"tools_theme",SearchTheme.active(c)):null;}
+ public static boolean dark(Context c,String theme){var colors=helium314.keyboard.latin.settings.Settings.getValues().mColors;boolean night=colors instanceof FormaColors f?f.getDark():(c.getResources().getConfiguration().uiMode&48)==32;return ThemeCatalog.effectiveDark(theme,night);}
+ public ToolMenuSurface699(String theme,boolean dark){this.theme=theme;this.dark=dark;}
+ @Override public boolean isStateful(){return true;}
+ @Override protected boolean onStateChange(int[] states){boolean pushed=false;for(int state:states)if(state==android.R.attr.state_pressed)pushed=true;float end=pushed?1:0;if(motion!=null)motion.cancel();if(!android.animation.ValueAnimator.areAnimatorsEnabled()){press=end;invalidateSelf();return true;}motion=android.animation.ValueAnimator.ofFloat(press,end);motion.setDuration(pushed?65:130);motion.addUpdateListener(a->{press=(Float)a.getAnimatedValue();invalidateSelf();});motion.start();return true;}
+ @Override public void jumpToCurrentState(){if(motion!=null)motion.end();}
+ @Override public void draw(Canvas c){Rect b=getBounds();int save=c.save();c.translate(b.left,b.top);caps.draw(c,b.width(),b.height(),theme,dark,0,press);c.restoreToCount(save);}
+ @Override public void setAlpha(int alpha){}@Override public void setColorFilter(ColorFilter filter){}@Override public int getOpacity(){return PixelFormat.TRANSLUCENT;}
+}
