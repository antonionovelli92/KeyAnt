diff --git a/app/src/main/java/helium314/keyboard/keyforma/NumericJolly699.java b/app/src/main/java/helium314/keyboard/keyforma/NumericJolly699.java
new file mode 100644
index 0000000..a602578
--- /dev/null
+++ b/app/src/main/java/helium314/keyboard/keyforma/NumericJolly699.java
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+
+import android.os.Handler;
+import android.os.Looper;
+import android.view.ViewConfiguration;
+import android.view.inputmethod.InputConnection;
+import helium314.keyboard.latin.LatinIME;
+import helium314.keyboard.keyboard.Keyboard;
+import helium314.keyboard.keyboard.KeyboardId;
+
+/** A separate gesture contract for the blank space key of the native numeric layout. */
+public final class NumericJolly699 {
+ public static final int HOLD=69901;
+ public static final String[] ACTIONS={"copy","select_all","paste","cut","undo","redo","space","none"};
+ public static String label(String id){return switch(id){case "copy"->"Copia selezione";case "select_all"->"Seleziona tutto";case "paste"->"Incolla";case "cut"->"Taglia selezione";case "undo"->"Annulla";case "redo"->"Ripeti";case "space"->"Spazio";default->"Nessuna azione";};}
+ public static boolean matches(Keyboard keyboard,int code){return code==32&&keyboard!=null&&(keyboard.mId.mElementId==KeyboardId.ELEMENT_NUMBER||keyboard.mId.mElementId==KeyboardId.ELEMENT_NUMPAD);}
+ private final LatinIME ime;
+ private final Handler handler=new Handler(Looper.getMainLooper());
+ private Runnable pending;
+ private InputConnection owner;
+ private Object editor;
+ public NumericJolly699(LatinIME ime){this.ime=ime;}
+ public void cancel(){if(pending!=null)handler.removeCallbacks(pending);pending=null;owner=null;editor=null;}
+ public void press(){if(pending!=null)handler.removeCallbacks(pending);}
+ public void tap(){
+  InputConnection ic=ime.getCurrentInputConnection();Object info=ime.getCurrentInputEditorInfo();
+  if(ic==null){cancel();return;}
+  if(pending!=null&&owner==ic&&editor==info){cancel();perform(ic,KeyAntPrefs.text(ime,"jolly_double","select_all"));return;}
+  cancel();owner=ic;editor=info;
+  pending=()->{boolean same=ime.getCurrentInputConnection()==ic&&ime.getCurrentInputEditorInfo()==info&&ime.isInputViewShown();cancel();if(same)perform(ic,KeyAntPrefs.text(ime,"jolly_tap","copy"));};
+  handler.postDelayed(pending,ViewConfiguration.getDoubleTapTimeout());
+ }
+ public void hold(){cancel();perform(ime.getCurrentInputConnection(),KeyAntPrefs.text(ime,"jolly_hold","paste"));}
+ private void perform(InputConnection ic,String action){if(ic!=null)apply(ic,action);}
+ public static boolean apply(InputConnection ic,String action){
+  // Copy/cut must never turn an empty selection into an implicit select-all.
+  if((action.equals("copy")||action.equals("cut"))&&android.text.TextUtils.isEmpty(ic.getSelectedText(0)))return false;
+  int id=switch(action){case "copy"->android.R.id.copy;case "select_all"->android.R.id.selectAll;case "paste"->android.R.id.paste;case "cut"->android.R.id.cut;case "undo"->android.R.id.undo;case "redo"->android.R.id.redo;default->0;};
+  if(id!=0)return ic.performContextMenuAction(id);
+  return action.equals("space")&&ic.commitText(" ",1);
+ }
+}
