+/** Per-theme native-render inventory. Images are review evidence, not similarity assertions. */
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk=35, qualifiers="w400dp-h900dp-mdpi", shadows={helium314.keyboard.ShadowInputMethodManager2.class})
+@GraphicsMode(GraphicsMode.Mode.NATIVE)
