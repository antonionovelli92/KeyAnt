+ Context c; LatinIME ime;
+ @Before public void setup(){c=RuntimeEnvironment.getApplication();KeyAntPrefs.get(c).edit().clear().putBoolean("ka_053_defaults",true).putBoolean(Settings.PREF_THEME_DAY_NIGHT,false).putBoolean("ka_theme_motion",false).putString("ka_rgb","off").apply();ime=Robolectric.setupService(LatinIME.class);}
+ @After public void close(){ime.onDestroy();}
+ void theme(String id,boolean dark){KeyAntPrefs.get(c).edit().putString(Settings.PREF_THEME_COLORS,ThemeCatalog.preference(id,dark)).apply();Settings.getInstance().loadSettings(c);KeyboardLayoutSet.onKeyboardThemeChanged();}
+ @Test public void everyCatalogThemeBothModesAndAllLayoutFamilies() throws Exception {
+  File dir=new File("build/keyant-artifacts/audit699");dir.mkdirs();int count=0;
+  try(PrintWriter manifest=new PrintWriter(new File(dir,"manifest.tsv"))){
+   manifest.println("id\tname\tcollection\trequested_dark\teffective_dark\twidth\tsplit\tnumbers\tball\tlayer\tkeys\timage");
+   for(int index=0;index<ThemeCatalog.IDS.length;index++){
+    String id=ThemeCatalog.IDS[index];
+    Bitmap sheet=Bitmap.createBitmap(1600,1400,Bitmap.Config.ARGB_8888);Canvas out=new Canvas(sheet);out.drawColor(0xff242629);
+    Paint title=new Paint(3);title.setColor(Color.WHITE);title.setTextSize(20);out.drawText(id+" | "+ThemeCatalog.NAMES[index],12,24,title);
+    for(int mode=0;mode<2;mode++)for(int config=0;config<4;config++){
+     boolean requestedDark=mode==1,dark=ThemeCatalog.effectiveDark(id,requestedDark),split=config==3,numbers=config==2,ball=config==1;
+     int width=config>=2?760:400,layer=config==1?KeyboardId.ELEMENT_SYMBOLS:config==3?KeyboardId.ELEMENT_SYMBOLS_SHIFTED:KeyboardId.ELEMENT_ALPHABET;
+     RuntimeEnvironment.setQualifiers(config==2?"w760dp-h400dp-land-mdpi":config==3?"w760dp-h900dp-port-mdpi":"w400dp-h900dp-port-mdpi");
+     KeyAntPrefs.get(c).edit().putBoolean("ka_magic_ball",ball).apply();theme(id,dark);
+     int height=DimensionProfiles697.height(c,DimensionProfiles697.current(c),Settings.getValues().mKeyAntRowHeight,numbers);
+     Keyboard k=new KeyboardLayoutSet.Builder(ime,null).setKeyboardGeometry(width,height).setSubtype(RichInputMethodManager.getInstance().getCurrentSubtype()).setSplitLayoutEnabled(split).setNumberRowEnabled(numbers).build().getKeyboard(layer);
+     int keys=0;for(Key key:k.getSortedKeys()){if(key.isSpacer())continue;assertTrue(id+" key="+key.getCode(),key.getWidth()>0&&key.getHeight()>0);assertTrue(id+" outside "+key.getCode(),key.getX()>=0&&key.getX()+key.getWidth()<=width+1);keys++;}
+     KeyboardView view=new KeyboardView(new ContextThemeWrapper(c,KeyboardTheme.getKeyboardTheme(c).mStyleId),null,R.attr.keyboardViewStyle,id.equals("glass")?new GlassColors(dark):new FormaColors(dark,id,c.getResources()));
+     view.setKeyboard(k);view.setBackgroundColor(ThemeCatalog.background(id,dark));
+     Bitmap warmup=KeyAntV63Test.render(view,width,height);MechanicalCaps.awaitMaterials();org.robolectric.Shadows.shadowOf(android.os.Looper.getMainLooper()).idle();view.invalidateAllKeys();warmup.recycle();
+     Bitmap render=KeyAntV63Test.render(view,width,height);String file=id+"-"+mode+"-"+config+".png";
+     try(FileOutputStream stream=new FileOutputStream(new File(dir,file))){render.compress(Bitmap.CompressFormat.PNG,100,stream);}
+     int x=(config%2)*800,y=44+mode*672+(config/2)*336;
+     out.drawBitmap(render,new Rect(0,0,width,height),new Rect(x,y,x+width,y+height),null);render.recycle();
+     manifest.println(id+"\t"+ThemeCatalog.NAMES[index]+"\t"+ThemeCatalog.collection(id)+"\t"+requestedDark+"\t"+dark+"\t"+width+"\t"+split+"\t"+numbers+"\t"+ball+"\t"+layer+"\t"+keys+"\t"+file);count++;
+    }
+    try(FileOutputStream stream=new FileOutputStream(new File(dir,id+"-sheet.png"))){sheet.compress(Bitmap.CompressFormat.PNG,100,stream);}sheet.recycle();
+    for(boolean dark:new boolean[]{false,true}){
+     RuntimeEnvironment.setQualifiers("w400dp-h900dp-port-mdpi");theme(id,dark);
+     ToolPanelTile694 tile=new ToolPanelTile694(c,"clipboard",Color.WHITE,0xff151515,"original",true,id);
+     Bitmap image=KeyAntV63Test.render(tile,132,100);MechanicalCaps.awaitMaterials();image.recycle();image=KeyAntV63Test.render(tile,132,100);
+     try(FileOutputStream stream=new FileOutputStream(new File(dir,id+"-menu-"+dark+".png"))){image.compress(Bitmap.CompressFormat.PNG,100,stream);}image.recycle();
+     assertTrue(id+" icon-caption",tile.caption.getTop()>=tile.icon.getBottom());
+    }
+    if(index%20==0)System.out.println("AUDIT_THEME="+index+"/"+ThemeCatalog.IDS.length+" "+id);
+   }
+  }
+  System.out.println("AUDIT_THEMES="+ThemeCatalog.IDS.length+" NATIVE_RENDERS="+count);
+ }
+}
