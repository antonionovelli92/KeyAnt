+++ b/app/src/main/java/helium314/keyboard/keyforma/DimensionLayers699.java
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+import android.content.*;
+import helium314.keyboard.keyboard.KeyboardId;
+/** Layer keys extend display/orientation/trackball profiles and inherit common dimensions. */
+public final class DimensionLayers699 {
+ private DimensionLayers699(){}
+ public static String root(String profile){int i=profile.indexOf("_layer_");return i<0?profile:profile.substring(0,i);}
+ public static String layer(int element){return switch(element){case KeyboardId.ELEMENT_NUMBER,KeyboardId.ELEMENT_NUMPAD,KeyboardId.ELEMENT_PHONE,KeyboardId.ELEMENT_PHONE_SYMBOLS->"numeric";case KeyboardId.ELEMENT_SYMBOLS->"symbols";case KeyboardId.ELEMENT_SYMBOLS_SHIFTED->"symbols2";default->"letters";};}
+ public static String profile(String profile,int element){return root(profile)+"_layer_"+layer(element);}
+ public static String profile(String profile,String layer){return layer.equals("all")?root(profile):root(profile)+"_layer_"+layer;}
+ public static int splitBaseHeight(Context c,KeyboardId source){if(KeyAntPrefs.bool(c,"floating",false)||height(c,DimensionProfiles697.current(c),source.mElementId,-1,source.mNumberRowEnabled)==-1)return source.mHeight;return helium314.keyboard.latin.utils.ResourceUtils.getKeyboardHeight(c.getResources(),helium314.keyboard.latin.settings.Settings.getValues());}
+ public static int height(Context c,String profile,int element,int original,boolean numbers){
+  String specific=profile(profile,element);SharedPreferences p=KeyAntPrefs.get(c);
+  if(!p.contains(DimensionProfiles697.key(specific,"row"))&&!p.contains(DimensionProfiles697.key(specific,"height"))&&!p.contains(DimensionProfiles697.key(DimensionProfiles697.base(specific),"row"))&&!p.contains(DimensionProfiles697.key(DimensionProfiles697.base(specific),"height")))return original;
+  return DimensionProfiles697.height(c,specific,DimensionProfiles697.row(c,specific,SearchTheme.active(c)),numbers);
+ }
+ public static java.util.Map<String,Object> snapshot(Context c){java.util.Map<String,Object> out=new java.util.HashMap<>();for(var e:KeyAntPrefs.get(c).getAll().entrySet())if(e.getKey().startsWith("ka_dim_"))out.put(e.getKey(),e.getValue());return out;}
