+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma
+import androidx.compose.runtime.*
+import androidx.compose.material3.*
+import androidx.compose.ui.platform.LocalContext
+@Composable internal fun AuthenticatorSettings700(){
+ val c=LocalContext.current
+ val apps=remember { AuthenticatorBridge700.choices(c).entries.map{it.key to it.value} }
+ StudioCard{
+  Toggle("Pillola Authenticator","authenticator_pill",true,"Compare nei campi riconosciuti per codici di verifica. Le pillole di Android e degli appunti mantengono la precedenza.")
+  Choice("App Authenticator","authenticator_app",AuthenticatorBridge700.GOOGLE,apps)
+  Choice("Apertura Authenticator","authenticator_window","compact",listOf("compact" to "Finestra compatta · se supportata","normal" to "Apertura normale"))
+  Toggle("Authenticator anche in incognito","authenticator_private",true,"Mostra solo il collegamento all’app, senza leggere account o codici. L’inserimento dagli appunti segue le sue impostazioni separate.")
+  TextButton(onClick={AuthenticatorBridge700.open(c)}){Text("Prova apertura Authenticator")}
+  Note("Copia il codice nell’app e torna al campo: la pillola degli appunti lo rende disponibile. KeyAnt non legge né genera i codici di Google Authenticator. La finestra compatta è una richiesta ad Android: il sistema può aprire comunque l’app a schermo intero. Non viene incorporata nella tastiera.")
+  Note("Se il sito non descrive il campo, il riconoscimento automatico può non riuscire. Puoi aggiungere Authenticator al menu ⋯ o alla barra in Organizza strumenti.")
+ }
+}
