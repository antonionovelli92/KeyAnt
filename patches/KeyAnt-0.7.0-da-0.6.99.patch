new file mode 100644
index 0000000..0066b9c
--- /dev/null
+++ b/app/src/main/java/helium314/keyboard/keyforma/VoiceText700.java
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+import android.content.Context;
+import java.util.*;
+import java.util.regex.*;
+
+/** Bounded Italian transcript editing; never infers facts or reconstructs an unknown word. */
+public final class VoiceText700 {
+ private static final Pattern LITERAL=Pattern.compile("\"[^\"]*\"|«[^»]*»|“[^”]*”|`[^`]*`|https?://\\S+|www\\.\\S+|[\\w.+-]+@[\\w.-]+|\\b\\S*[0-9/:_]\\S*");
+ private static final Pattern WORD=Pattern.compile("[\\p{L}]+(?:[’'][\\p{L}]+)?");
+ private static final Pattern REPEAT=Pattern.compile("(?iu)\\b(di|a|da|in|con|su|per|tra|fra|il|lo|la|gli|le|un|una|che|cosa|come)(?:[ \\t]+\\1)+\\b");
+ private static final Pattern BROKEN=Pattern.compile("(?iu)\\b(di|del|della|delle|degli|dei|con|per|dello|allo|alla|nella|nelle|nel|sul|sulla|che)\\.[ \\t]+(?=\\p{L})");
+ private static final String TIME="adesso|ora|oggi|ieri|domani|stasera|stamattina|stanotte";
+ private static final Pattern RETHINK=Pattern.compile("(?iu)\\b("+TIME+")[ ,]+anzi(?:[ ,]+no)?[ ,]+(?:(?:di|da|per)[ \\t]+)?("+TIME+")\\b");
+ private static final Set<String> COMMON=Set.of("io","tu","lui","lei","noi","voi","loro","non","no","si","sì","di","a","da","in","con","su","per","tra","fra","il","lo","la","gli","le","un","una","che","e","è","ma","o","se","come","cosa","quanto","quando","dove","perché","quindi","allora","ecco","anche","però","oppure","infatti","adesso","oggi","ieri","domani","anzi","bisogna","vediamo","capisce","capisci","diciamo","testo","frase","parole","caratteri","scrittura","vocale","scritto");
+ private static BitSet protectedSpans(String value,List<Pattern> terms){BitSet bits=new BitSet(value.length());ArrayList<Pattern> all=new ArrayList<>(terms);all.add(LITERAL);for(Pattern p:all){Matcher m=p.matcher(value);while(m.find())bits.set(m.start(),m.end());}return bits;}
+ private static boolean protectedAt(BitSet bits,int start,int end){int n=bits.nextSetBit(start);return n>=0&&n<end;}
+ private static String replace(String value,Pattern pattern,int group,List<Pattern> terms,String suffix){BitSet bits=protectedSpans(value,terms);Matcher m=pattern.matcher(value);StringBuffer out=new StringBuffer();while(m.find())m.appendReplacement(out,Matcher.quoteReplacement(protectedAt(bits,m.start(),m.end())?m.group():m.group(group)+suffix));m.appendTail(out);return out.toString();}
+ static String caseOnly(String value,List<Pattern> terms){
+  if(value==null||value.length()>32000)return value;BitSet bits=protectedSpans(value,terms);Matcher m=WORD.matcher(value);StringBuffer out=new StringBuffer();
+  while(m.find()){
+   String word=m.group(),fixed=word;int previous=m.start()-1;while(previous>=0&&(value.charAt(previous)==' '||value.charAt(previous)=='\t'))previous--;
+   boolean start=previous<0||".!?\n".indexOf(value.charAt(previous))>=0;
+   if(!protectedAt(bits,m.start(),m.end())){
+    if(start&&Character.isLowerCase(word.charAt(0)))fixed=Character.toUpperCase(word.charAt(0))+word.substring(1);
+    else if(!start&&word.length()>1&&Character.isUpperCase(word.charAt(0))&&word.substring(1).equals(word.substring(1).toLowerCase(Locale.ITALIAN))&&COMMON.contains(word.toLowerCase(Locale.ITALIAN)))fixed=word.toLowerCase(Locale.ITALIAN);
+   }
+   m.appendReplacement(out,Matcher.quoteReplacement(fixed));
+  }m.appendTail(out);return out.toString();
+ }
+ public static String clean(Context c,String text){
+  if(text==null||text.length()>32000)return text;var terms=VoiceOptions.protectedTerms(c,text);
+  String value=replace(text,REPEAT,1,terms,"");
+  if(KeyAntPrefs.bool(c,"voice_temporal_repairs",true))value=replace(value,RETHINK,2,terms,"");
+  value=replace(value,BROKEN,1,terms," ");
+  return caseOnly(value,terms);
+ }
+ public static String live(Context c,String text,String language){
+  if(language==null||!language.startsWith("it")||!KeyAntPrefs.bool(c,"voice_readable",true))return text;
+  // No vocabulary scan or AI model in the partial-result path.
+  return caseOnly(text,List.of());
+ }
+}
