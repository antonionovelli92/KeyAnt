diff --git a/app/src/main/java/helium314/keyboard/keyforma/AuthenticatorBridge700.java b/app/src/main/java/helium314/keyboard/keyforma/AuthenticatorBridge700.java
new file mode 100644
index 0000000..7b643a0
--- /dev/null
+++ b/app/src/main/java/helium314/keyboard/keyforma/AuthenticatorBridge700.java
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+
+import android.app.*;
+import android.content.*;
+import android.content.pm.PackageManager;
+import android.graphics.Rect;
+import android.os.SystemClock;
+import android.text.InputType;
+import android.view.*;
+import android.view.inputmethod.EditorInfo;
+import android.widget.*;
+import helium314.keyboard.latin.LatinIME;
+import helium314.keyboard.latin.settings.Settings;
+import helium314.keyboard.latin.common.ColorType;
+import java.util.*;
+import java.util.regex.Pattern;
+
+/** User-initiated launch only. No account database, secret, screen or TOTP access. */
+public final class AuthenticatorBridge700 {
+ public static final String GOOGLE="com.google.android.apps.authenticator2", MICROSOFT="com.azure.authenticator";
+ private static final Pattern POSITIVE=Pattern.compile("(?iu)(?:\\b(?:otp|totp|2fa|mfa|authenticator)\\b|one[ -]?time(?:[ -]?(?:code|password))?|verification[ -]?code|authentication[ -]?code|two[ -]?(?:step|factor)|codice(?: di)? (?:verifica|autenticazione|monouso)|codice (?:a|di) (?:6|sei|8|otto) cifre)");
+ private static final Pattern NEGATIVE=Pattern.compile("(?iu)codice (?:fiscale|postale|cliente|prodotto|sconto|articolo)|postal|zip code|coupon|promo code|cvv|cvc|card security|sicurezza della carta");
+ private EditorInfo dismissed;
+ private String cachedPackage;private boolean available;private long checked=-30000;
+ public static boolean codeField(EditorInfo e){
+  if(e==null||e.inputType==InputType.TYPE_NULL)return false;
+  String labels=(String.valueOf(e.hintText)+" "+String.valueOf(e.fieldName)).replaceAll("([a-z])([A-Z])","$1 $2").replace('_',' ').replace('-',' ');
+  return !NEGATIVE.matcher(labels).find()&&POSITIVE.matcher(labels).find();
+ }
+ public static boolean privateField(EditorInfo e){return e!=null&&((e.imeOptions&EditorInfo.IME_FLAG_NO_PERSONALIZED_LEARNING)!=0||helium314.keyboard.latin.utils.InputTypeUtils.isPasswordInputType(e.inputType));}
+ public static String selected(Context c){return KeyAntPrefs.text(c,"authenticator_app",GOOGLE);}
+ public static String name(Context c,String pkg){
+  if(GOOGLE.equals(pkg))return "Google Authenticator";if(MICROSOFT.equals(pkg))return "Microsoft Authenticator";
+  try{return c.getPackageManager().getApplicationLabel(c.getPackageManager().getApplicationInfo(pkg,0)).toString();}catch(PackageManager.NameNotFoundException|RuntimeException ex){return "App Authenticator";}
+ }
+ public static LinkedHashMap<String,String> choices(Context c){
+  LinkedHashMap<String,String> out=new LinkedHashMap<>();out.put(GOOGLE,"Google Authenticator");out.put(MICROSOFT,"Microsoft Authenticator");
+  Intent query=new Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER);
+  var apps=c.getPackageManager().queryIntentActivities(query,0);apps.sort(Comparator.comparing(x->x.loadLabel(c.getPackageManager()).toString().toLowerCase(Locale.ROOT)));
+  for(var app:apps)if(!app.activityInfo.packageName.equals(c.getPackageName()))out.putIfAbsent(app.activityInfo.packageName,app.loadLabel(c.getPackageManager()).toString());
+  return out;
+ }
+ private boolean installed(Context c,String pkg){long now=SystemClock.elapsedRealtime();if(!pkg.equals(cachedPackage)||now-checked>30000){cachedPackage=pkg;checked=now;available=c.getPackageManager().getLaunchIntentForPackage(pkg)!=null;}return available;}
+ public static boolean unlocked(Context c){KeyguardManager km=c.getSystemService(KeyguardManager.class);return km==null||!km.isDeviceLocked();}
+ public static Rect compactBounds(int width,int height){int w=Math.min(width,Math.max(1,Math.round(width*.82f))),h=Math.min(height,Math.max(1,Math.round(height*.62f)));return new Rect((width-w)/2,(height-h)/3,(width+w)/2,(height-h)/3+h);}
+ public static Intent launch(Context c){return launch(c,selected(c));}
+ private static Intent launch(Context c,String pkg){Intent i=c.getPackageManager().getLaunchIntentForPackage(pkg);return i==null?null:i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);}
+ public static boolean open(Context c){return open(c,selected(c));}
+ public static boolean open(Context c,String pkg){
+  if(!unlocked(c))return false;Intent i=launch(c,pkg);
+  if(i==null){Toast.makeText(c,"Scegli un’app Authenticator installata in Appunti e codici",Toast.LENGTH_LONG).show();return false;}
+  boolean compact=KeyAntPrefs.text(c,"authenticator_window","compact").equals("compact")&&c.getPackageManager().hasSystemFeature(PackageManager.FEATURE_FREEFORM_WINDOW_MANAGEMENT);
+  try{
+   if(compact){var dm=c.getResources().getDisplayMetrics();c.startActivity(i,ActivityOptions.makeBasic().setLaunchBounds(compactBounds(dm.widthPixels,dm.heightPixels)).toBundle());}
+   else c.startActivity(i);
+   return true;
+  }catch(RuntimeException first){if(compact)try{c.startActivity(i);return true;}catch(RuntimeException ignored){}Toast.makeText(c,"Impossibile aprire l’app Authenticator scelta",Toast.LENGTH_SHORT).show();return false;}
+ }
+ public static void settings(Context c){c.startActivity(new Intent(c,StudioActivity.class).putExtra("page","privacy").putExtra("target_setting","Pillola Authenticator").addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));}
+ public View suggestion(LatinIME ime){
+  EditorInfo e=ime.getCurrentInputEditorInfo();
+  if(e==dismissed||!codeField(e)||!unlocked(ime)||!KeyAntPrefs.bool(ime,"authenticator_pill",true))return null;
+  boolean privacy=Settings.getValues().mIncognitoModeEnabled||privateField(e);
+  if(privacy&&!KeyAntPrefs.bool(ime,"authenticator_private",true))return null;
+  String pkg=selected(ime);if(!installed(ime,pkg))return null;
+  return pill(ime,name(ime,pkg),()->{if(ime.getCurrentInputEditorInfo()==e&&KeyAntPrefs.bool(ime,"authenticator_pill",true)&&(!privacy||KeyAntPrefs.bool(ime,"authenticator_private",true)))open(ime);},()->{dismissed=e;ime.showKeyAntTools();},()->settings(ime));
+ }
+ public static View pill(Context c,String label,Runnable open,Runnable dismiss,Runnable settings){
+  float d=c.getResources().getDisplayMetrics().density;int ink=Settings.getValues().mColors.get(ColorType.KEY_TEXT);
+  PastePill.Halo halo=new PastePill.Halo(c,ink);
+  LinearLayout row=new LinearLayout(c){@Override protected void onDetachedFromWindow(){halo.stop();super.onDetachedFromWindow();}};
+  row.setTag("keyant-authenticator");row.setGravity(Gravity.CENTER_VERTICAL);
+  ImageButton close=new ImageButton(c);close.setImageDrawable(new ToolbarIcon("back",ink,(int)(22*d)));close.setBackgroundColor(android.graphics.Color.TRANSPARENT);close.setContentDescription("Nascondi Authenticator in questo campo");close.setOnClickListener(v->dismiss.run());TouchFeedback.install(close);row.addView(close,new LinearLayout.LayoutParams((int)(44*d),(int)(48*d)));
+  TextView chip=new TextView(c);chip.setText(label);chip.setTextColor(ink);chip.setTextSize(14);chip.setMaxLines(1);chip.setHorizontallyScrolling(false);chip.setIncludeFontPadding(false);chip.setEllipsize(android.text.TextUtils.TruncateAt.END);chip.setGravity(Gravity.CENTER);chip.setPadding((int)(12*d),0,(int)(12*d),0);chip.setBackground(halo);chip.setCompoundDrawablesWithIntrinsicBounds(new ToolbarIcon("authenticator",ink,(int)(22*d)),null,null,null);chip.setCompoundDrawablePadding((int)(6*d));chip.setContentDescription("Apri "+label+" per copiare il codice");chip.setOnClickListener(v->open.run());TouchFeedback.install(chip);row.addView(chip,new LinearLayout.LayoutParams(0,(int)(44*d),1));
+  ImageButton edit=new ImageButton(c);edit.setImageDrawable(new ToolbarIcon("settings",ink,(int)(21*d)));edit.setBackgroundColor(android.graphics.Color.TRANSPARENT);edit.setContentDescription("Impostazioni Authenticator");edit.setOnClickListener(v->settings.run());TouchFeedback.install(edit);row.addView(edit,new LinearLayout.LayoutParams((int)(44*d),(int)(48*d)));return row;
+ }
+}
