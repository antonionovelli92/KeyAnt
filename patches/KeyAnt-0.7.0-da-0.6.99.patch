@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma
+import android.content.Context
+internal object AntControls700 {
+ val entries=listOf(
+  SettingResult("privacy","Pillola Authenticator","Google Microsoft codici monouso OTP TOTP 2FA verifica apri app"),
+  SettingResult("privacy","App Authenticator","Google Microsoft cambia applicazione codice"),
+  SettingResult("privacy","Apertura Authenticator","finestra piccola compatta popup Samsung Fold normale"),
+  SettingResult("privacy","Authenticator anche in incognito","login privato collegamento pillola"),
+  SettingResult("voice","Anteprima vocale leggibile","maiuscole minuscole pause trascrizione"),
+  SettingResult("voice","Ripensamenti temporali espliciti","adesso anzi no oggi ieri domani correzione"))
+ fun guide(q:String):AntGuide.Answer?=when{
+  "authenticator" in q||Regex("codic.*(?:monouso|2fa|totp)").containsMatchIn(q)->AntGuide.Answer("La pillola apre l’app scelta nei campi riconosciuti per codici. Google è la prima scelta; puoi usare Microsoft o un’altra app. Copia il codice e torna: lo propone la pillola degli appunti. KeyAnt non legge l’archivio né genera codici di Google. La finestra compatta dipende da Android e può aprirsi a schermo intero. Se il campo non è descritto, usa Authenticator nel menu ⋯.",authLinks(q))
+  Regex("maiuscol|minuscol|ripetizion|esitazion|ripensament|paus.*vocal").containsMatchIn(q)->AntGuide.Answer("In Dettatura → Testo, Pulizia prudente mostra un confronto con l’originale: ripetizioni brevi, maiuscole comuni e interruzioni evidenti. Ripensamenti temporali espliciti tratta «adesso, anzi no, oggi». Puoi spegnerlo; le frasi ambigue restano da rivedere. Per correzioni contestuali più ampie puoi scegliere AI locale se il modello è già installato.",listOf(SettingResult("voice","Pulizia della dettatura"),entries[4],entries[5]))
+  else->null
+ }
+ private fun authLinks(q:String):List<SettingResult> = when {
+  "incognito" in q || "privat" in q -> listOf(entries[3])
+  Regex("apertura|finestra|popup|compatta").containsMatchIn(q) -> listOf(entries[2])
+  Regex("app authenticator|cambia.*app|scegli.*app").containsMatchIn(q) -> listOf(entries[1])
+  "pillola" in q || "impostaz" in q -> listOf(entries[0])
+  else -> entries.take(4)
+ }
+ fun submit(c:Context,text:String,previous:AntDialog.Turn?):AntDialog.Turn?{
+  val q=SettingsSearch.normal(text)
+  if(text.trimEnd().endsWith('?')&&!q.startsWith("puoi "))return null
+  if(!Regex("^(?:(?:ant|ok|mi|puoi|per favore) )*(?:apri|avvia|usa|metti|imposta|cambia)\\b").containsMatchIn(q))return null
+  if("authenticator" !in q&&previous?.target !in entries.take(4).map{it.title})return null
+  val p=KeyAntPrefs.get(c)
+  val pkg=when{ "microsoft" in q->AuthenticatorBridge700.MICROSOFT;"google" in q->AuthenticatorBridge700.GOOGLE;else->null }
+  if(Regex("apri|avvia").containsMatchIn(q)&&!Regex("impostaz|preferenze").containsMatchIn(q)){
+   val ok=AuthenticatorBridge700.open(c,pkg?:AuthenticatorBridge700.selected(c))
+   return AntDialog.Turn(text,if(ok)"Richiesta apertura dell’app Authenticator scelta." else "L’app scelta non è disponibile: puoi cambiarla nelle impostazioni.",target=entries[0].title,page="privacy")
+  }
+
+  if(pkg!=null){p.edit().putString("ka_authenticator_app",pkg).apply();return AntDialog.Turn(text,"App scelta: "+AuthenticatorBridge700.name(c,pkg)+".",target=entries[1].title,page="privacy")}
+  val mode=when{Regex("normale|schermo intero").containsMatchIn(q)->"normal";Regex("piccola|compatta|popup|finestra").containsMatchIn(q)->"compact";else->null}
+  if(mode!=null){p.edit().putString("ka_authenticator_window",mode).apply();return AntDialog.Turn(text,if(mode=="compact")"Richiesta finestra compatta: Android può ignorarla e aprire normalmente." else "Authenticator si apre normalmente.",target=entries[2].title,page="privacy")}
+  return null
+ }
+}
