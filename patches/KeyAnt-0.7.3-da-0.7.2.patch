diff --git a/app/src/main/java/helium314/keyboard/keyforma/AdaptiveTouch.java b/app/src/main/java/helium314/keyboard/keyforma/AdaptiveTouch.java
index 758f0a1..3db816d 100644
--- a/app/src/main/java/helium314/keyboard/keyforma/AdaptiveTouch.java
+++ b/app/src/main/java/helium314/keyboard/keyforma/AdaptiveTouch.java
@@ -44,21 +44,23 @@ public final class AdaptiveTouch {
  }
  static Key resolve(Keyboard keyboard,Key primary,int x,int y,float[] probabilities){return resolve(keyboard,primary,x,y,probabilities,false);}
  static Key resolve(Keyboard keyboard,Key primary,int x,int y,float[] probabilities,boolean calibrated){
-  if(keyboard==null||!keyboard.mId.isAlphabetKeyboard()||primary==null||primary.isSpacer()||primary.getWidth()<=0||primary.getHeight()<=0)return primary;
+  if(probabilities==null||probabilities.length!=26||keyboard==null||!keyboard.mId.isAlphabetKeyboard()||primary==null||primary.isSpacer()||primary.getWidth()<=0||primary.getHeight()<=0)return primary;
   int code=Character.toLowerCase(primary.getCode());if(code<'a'||code>'z')return primary;
   float nx=(x-primary.getX())/(float)primary.getWidth(),ny=(y-primary.getY())/(float)primary.getHeight();
   // Central 76% of each cap is invariant, even with a confident language prediction.
   if(nx>=.12f&&nx<=.88f&&ny>=.12f&&ny<=.88f)return primary;
-  Key best=primary;float confidence=probabilities[code-'a'];
+  Key best=primary;float confidence=probabilities[code-'a'];float bestScore=-1;
+  if(!Float.isFinite(confidence))return primary;
   for(Key k:keyboard.getNearestKeys(x,y)){
    int c=Character.toLowerCase(k.getCode());if(k==primary||k.getWidth()<=0||k.getHeight()<=0||k.isSpacer()||c<'a'||c>'z')continue;
-   float p=probabilities[c-'a'];if(p<.70f||p<confidence+.55f)continue;
+   float p=probabilities[c-'a'];if(!Float.isFinite(p)||p<.70f||p<confidence+.55f)continue;
    // Only the narrow border of an immediate neighbour; never jump across a split gap.
    float dx=Math.max(k.getX()-x,Math.max(0,x-k.getX()-k.getWidth()));
    float dy=Math.max(k.getY()-y,Math.max(0,y-k.getY()-k.getHeight()));
    if(Math.hypot(dx/k.getWidth(),dy/k.getHeight())>.12)continue;
    if(calibrated){float primaryScore=Math.max(.05f,probabilities[code-'a'])*TouchCalibration.likelihood(keyboard,primary,x,y);float candidateScore=p*TouchCalibration.likelihood(keyboard,k,x,y);if(candidateScore<primaryScore*1.2f)continue;}
-   best=k;confidence=p;
+   float score=calibrated?p*TouchCalibration.likelihood(keyboard,k,x,y):p;
+   if(score>bestScore||(score==bestScore&&k.getCode()<best.getCode())){best=k;bestScore=score;}
   }
   return best;
  }
diff --git a/app/src/main/java/helium314/keyboard/keyforma/AntControls703.kt b/app/src/main/java/helium314/keyboard/keyforma/AntControls703.kt
new file mode 100644
index 0000000..b8c1ec5
--- /dev/null
+++ b/app/src/main/java/helium314/keyboard/keyforma/AntControls703.kt
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma
+import android.content.Context
+internal object AntControls703 {
+ val entries=listOf(SettingResult("voice","Dove scrive la dettatura","vocale diretto campo messaggio card anteprima"),SettingResult("voice","Motore vocale","Parakeet offline Android riconoscimento dispositivo"),SettingResult("voice","Effetto della pillola vocale","animazione vetro arcobaleno onda spettro microfono"))
+ fun guide(q:String):AntGuide.Answer?=if(Regex("parakeet|dettatura.*(?:diretta|campo)|pillola.*(?:vocal|arcobaleno)|effett.*microfono").containsMatchIn(q))AntGuide.Answer("Puoi scrivere direttamente nel messaggio oppure rivedere nella card. Parakeet v3 è facoltativo, offline e aggiorna per frasi dopo brevi pause: richiede il download di 671 MB in Dettatura. In Microfono · aspetto scegli l’effetto, compreso Vetro arcobaleno. Puoi chiedermi «usa dettatura nel campo», «usa la card di revisione» oppure «metti la pillola vocale vetro arcobaleno».",entries)else null
+ fun submit(c:Context,text:String,previous:AntDialog.Turn?):AntDialog.Turn?{
+  val q=SettingsSearch.normal(text)
+  if(text.trimEnd().endsWith('?')&&!q.startsWith("puoi "))return null
+  if(!Regex("^(?:(?:ant|ok|mi|puoi|per favore) )*(?:usa|metti|imposta|cambia|attiva(?:la|lo)?|disattiva(?:la|lo)?)\\b").containsMatchIn(q))return null
+  val voice=Regex("vocal|dettatura|parakeet|microfono").containsMatchIn(q)
+  val related=voice||previous?.target in entries.map{it.title}
+  if(!related||(!voice&&Regex("tastiera|tema|trackball|appunti|rgb").containsMatchIn(q)))return null
+  var key:String?=null;var value:String?=null;var index=0
+  val off=Regex("\\bdisattiva(?:la|lo)?\\b").containsMatchIn(q)
+  val context=previous?.target
+  if(off&&("parakeet" in q||context==entries[1].title)){key="voice_engine";value="auto";index=1}
+  else if((off||q.startsWith("attiva"))&&(Regex("effetto|animazion|pillola").containsMatchIn(q)||context==entries[2].title)){key="voice_indicator";value=if(off)"text" else "wave";index=2}
+  else if(off&&(Regex("diretta|campo").containsMatchIn(q)||context==entries[0].title)){key="voice_destination";value="preview"}
+  else
+  if(Regex("campo|diretta|messaggio").containsMatchIn(q)){key="voice_destination";value="field"}
+  else if(Regex("card|revisione|anteprima").containsMatchIn(q)){key="voice_destination";value="preview"}
+  else if("parakeet" in q){key="voice_engine";value="parakeet";index=1}
+  else if("automatico" in q){key="voice_engine";value="auto";index=1}
+  else if("dispositivo" in q){key="voice_engine";value="device";index=1}
+  else if("android" in q){key="voice_engine";value="system";index=1}
+  else {val effect=VoiceWave.NAMES.indices.firstOrNull{SettingsSearch.normal(VoiceWave.NAMES[it]) in q}?:if("arcobaleno" in q||"glass" in q)VoiceWave.IDS.indexOf("glass")else null
+   if(effect!=null){key="voice_effect";value=VoiceWave.IDS[effect];index=2}}
+  if(key==null||value==null)return null
+  if(value=="parakeet"&&!ParakeetModel703.ready(c))return AntDialog.Turn(text,"Prima scarica il modello in Dettatura: 671 MB. Il motore attuale resta selezionato.",target=entries[1].title,page="voice")
+  KeyAntPrefs.get(c).edit().putString("ka_"+key,value).apply()
+  // An explicit style selection also makes the animation visible.
+  if(key=="voice_effect")KeyAntPrefs.get(c).edit().putString("ka_voice_indicator","wave").apply()
+  if(key=="voice_effect"||key=="voice_indicator"){
+   val active=SuggestionLook.active()
+   if(active!=null&&active.optString("id").startsWith("make_")){
+    val copy=org.json.JSONObject(active.toString()).put(key,value)
+    if(key=="voice_effect")copy.put("voice_indicator","wave")
+    MakeKeyAnt.save(c,copy);KeyAntPrefs.get(c).edit().putString("ka_maker_applied",copy.toString()).apply();MakeKeyAnt.init(c)
+   }
+  }
+  return AntDialog.Turn(text,when(key){"voice_destination"->if(value=="field")"La dettatura scrive nel campo del messaggio, senza inviarlo." else "La dettatura usa la card di revisione.";"voice_indicator"->if(value=="text")"Animazione vocale disattivata; lo stile scelto resta memorizzato." else "Animazione vocale attivata.";"voice_effect"->"Effetto vocale: "+VoiceWave.NAMES[VoiceWave.IDS.indexOf(value)]+".";else->"Motore vocale impostato: $value."},target=entries[index].title,page="voice")
+ }
+}
