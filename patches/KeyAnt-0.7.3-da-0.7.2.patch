--- /dev/null
+++ b/tools/fetch-parakeet-runtime.py
@@ -0,0 +1,19 @@
+#!/usr/bin/env python3
+"""Fetch the pinned Android runtime. Does not download speech models or user audio."""
+import hashlib,urllib.request,os
+from pathlib import Path
+root=Path(__file__).resolve().parent.parent
+url="https://github.com/k2-fsa/sherpa-onnx/releases/download/v2.0.3/sherpa-onnx-2.0.3.aar"
+expected="4c766e2e74c9d33d595338c21fe3b305c73ba45d47e96a235675c33142a2ec50"
+out=root/"app/libs/sherpa-onnx-2.0.3.aar"
+if out.exists() and hashlib.sha256(out.read_bytes()).hexdigest()==expected:
+ print("Runtime already verified")
+else:
+ out.parent.mkdir(parents=True,exist_ok=True)
+ temp=out.with_suffix(".part")
+ try:
+  with urllib.request.urlopen(url,timeout=60) as r,temp.open("wb") as f:
+   while chunk:=r.read(1024*1024):f.write(chunk)
+  if hashlib.sha256(temp.read_bytes()).hexdigest()!=expected:raise RuntimeError("Runtime SHA256 mismatch")
+  os.replace(temp,out);print("Runtime downloaded and verified")
+ finally:temp.unlink(missing_ok=True)
