+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+import android.content.Context;
+import android.content.pm.ActivityInfo;
+import android.graphics.*;
+import android.os.Build;
+import android.view.Window;
+/** Optional HDR only for the tiny RGB light sources. The key pigment stays SDR. */
+public final class OpticalHdr692 {
+ private OpticalHdr692(){}
+ private static final android.util.LruCache<Long,Bitmap> lights=new android.util.LruCache<>(48);
+ public static float requested(Context context){return switch(KeyAntPrefs.text(context,"rgb_hdr","off")){case "soft"->1.5f;case "bright"->2f;default->1f;};}
+ public static void window(Window window,Context context){
+  if(window==null||Build.VERSION.SDK_INT<34)return;
+  boolean enabled=!KeyEffects.effectiveMode(context).equals("off")&&requested(context)>1&&window.getWindowManager().getDefaultDisplay().isHdr();
+  int mode=enabled?ActivityInfo.COLOR_MODE_HDR:ActivityInfo.COLOR_MODE_DEFAULT;
+  if(window.getColorMode()!=mode)window.setColorMode(mode);
+  if(Build.VERSION.SDK_INT>=35)window.setDesiredHdrHeadroom(enabled?requested(context):0f);
+ }
+ public static Bitmap light(Bitmap source,int color,float ratio){
+  if(Build.VERSION.SDK_INT<34||ratio<=1)return source;
+  ratio=Math.max(1,Math.min(2,ratio));long key=((long)color&0xffffffffL)|((long)Math.round(ratio*10)<<32);
+  Bitmap bitmap=lights.get(key);if(bitmap!=null)return bitmap;
+  int w=source.getWidth(),h=source.getHeight();int[] pixels=new int[w*h];source.getPixels(pixels,0,w,0,0,w,h);
+  for(int i=0;i<pixels.length;i++)pixels[i]=(pixels[i]&0xff000000)|(color&0xffffff);
+  bitmap=Bitmap.createBitmap(pixels,w,h,Bitmap.Config.ARGB_8888);
+  Bitmap gain=Bitmap.createBitmap(1,1,Bitmap.Config.ARGB_8888);gain.eraseColor(Color.WHITE);
+  Gainmap map=new Gainmap(gain);map.setRatioMin(1,1,1);map.setRatioMax(ratio,ratio,ratio);map.setGamma(1,1,1);map.setEpsilonSdr(0,0,0);map.setEpsilonHdr(0,0,0);map.setMinDisplayRatioForHdrTransition(1);map.setDisplayRatioForFullHdr(ratio);bitmap.setGainmap(map);lights.put(key,bitmap);return bitmap;
+ }
+}
