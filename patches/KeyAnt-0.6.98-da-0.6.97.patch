+ static synchronized VibrationEffect preparedEffect(Context c,Vibrator v){
+  int strength=KeyAntPrefs.number(c,"haptic_strength",15),duration=KeyAntPrefs.number(c,"haptic_duration",8);String profile=KeyAntPrefs.text(c,"haptic_profile","precise");
+  Prepared old=prepared.get(v);
+  if(old!=null&&old.strength==strength&&old.duration==duration&&old.profile.equals(profile))return old.effect;
+  VibrationEffect value=effect(c,v);prepared.put(v,new Prepared(strength,duration,profile,value));return value;
+ }
+ private static synchronized boolean hasMotor(Vibrator v){Boolean cached=motors.get(v);if(cached==null){cached=v.hasVibrator();motors.put(v,cached);}return cached;}
