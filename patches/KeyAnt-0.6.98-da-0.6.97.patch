+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma
+
+import android.content.Context
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.drawBehind
+import androidx.compose.ui.geometry.CornerRadius
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.drawscope.Stroke
+import androidx.compose.ui.unit.dp
+
+internal data class AntSuggestion698(val title:String,val detail:String,val question:String)
+internal object AntSuggestions698 {
+ fun choose(c:Context,history:List<String>,visit:Int):List<AntSuggestion698>{
+  val p=KeyAntPrefs.get(c)
+  val last=history.lastOrNull()?.let(AntDialog::read)
+  val contextual=last?.target?.takeIf{it in AntSwitches.keys}?.let{target->
+   val key=AntSwitches.keys.getValue(target)
+   if(!p.contains(key))AntSuggestion698("Apri",target,"Apri "+target)
+   else {val enabled=p.getBoolean(key,false);AntSuggestion698(if(enabled)"Disattiva" else "Attiva",target,(if(enabled)"Disattiva " else "Attiva ")+target)}
+  }
+  val pool=listOf(
+   AntSuggestion698("Il tuo tema","Una proposta da provare","Consigliami un tema"),
+   AntSuggestion698("Barra icone",if(p.getBoolean("ka_toolbar_match_theme",false))"Già coordinata al tema" else "Abbinala alla tastiera","Come si attiva Coordina barra icone?"),
+   AntSuggestion698("Angoli",if(p.getBoolean("ka_rounded_keyboard",false))"Stondatura attiva" else "Personalizza il bordo","Dove trovo Angoli arrotondati?"),
+   AntSuggestion698("Effetti al tocco","Tema o preferenze personali","Come funzionano gli effetti originali del tema?"),
+   AntSuggestion698("Scrittura","Parole e sequenze personali","Dove trovo Impara mentre scrivo?"),
+   AntSuggestion698("Vibrazione","Regola il feedback dei tasti","Dove trovo Suono e vibrazione?"),
+   AntSuggestion698("MakerAnt","Una bozza da personalizzare","Fammi una tastiera meccanica con luce viola"),
+   AntSuggestion698("Dimensioni","Regolazioni per ogni schermo","Apri dimensioni della tastiera")
+  )
+  val offset=Math.floorMod(visit+history.size,pool.size)
+  return listOfNotNull(contextual)+List(if(contextual==null)3 else 2){pool[(offset+it)%pool.size]}
+ }
+}
+
+/** Soft halo drawn once per UI update: no blur layer or perpetual animation during typing. */
+internal fun Modifier.antGlow698(color:Color,radius:Float=24f)=drawBehind{
+ for(width in listOf(12f,7f,2f))drawRoundRect(color.copy(alpha=if(width==2f).22f else .035f),cornerRadius=CornerRadius(radius.dp.toPx()),style=Stroke(width.dp.toPx()))
+}
