diff --git a/app/src/main/java/helium314/keyboard/keyforma/ProofreadPolicy698.java b/app/src/main/java/helium314/keyboard/keyforma/ProofreadPolicy698.java
new file mode 100644
index 0000000..2937c61
--- /dev/null
+++ b/app/src/main/java/helium314/keyboard/keyforma/ProofreadPolicy698.java
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+
+import android.content.Context;
+import java.util.*;
+import java.util.regex.*;
+
+/** Conservative acceptance for an explicitly requested paragraph review, never auto-insertion. */
+final class ProofreadPolicy698 {
+ private static final Pattern WORD=Pattern.compile("[\\p{L}][\\p{L}’'-]*");
+ private static final Pattern LITERAL=Pattern.compile("https?://\\S+|[\\w.+-]+@[\\w.-]+|`[^`]*`");
+ private static final Set<String> OPENERS=Set.of("io","tu","lui","lei","noi","voi","loro","il","lo","la","gli","le","un","una","ciao","buongiorno","buonasera","oggi","ieri","domani","questa","questo","perché","perche","non","sono","ho","hai","ha","i","the","we","you","hello","it","this");
+ static boolean useModel(Context c,String mode,String source){
+  return !mode.equals("correct") || source.length()<=8000 && KeyAntPrefs.bool(c,"contextual_proofreading",true);
+ }
+ static boolean acceptable(Context c,String source,String candidate){
+  if(!VoiceCleanup.acceptable(source,candidate))return false;
+  if(!VoiceOptions.retained(VoiceOptions.protectedTerms(c,source),source,candidate))return false;
+  return protectedTokens(source).equals(protectedTokens(candidate));
+ }
+ static Map<String,Integer> protectedTokens(String text){
+  Map<String,Integer> result=new TreeMap<>();
+  Matcher literals=LITERAL.matcher(text);
+  while(literals.find())result.merge(literals.group(),1,Integer::sum);
+  Matcher words=WORD.matcher(text);
+  while(words.find()){
+   String word=words.group(),low=word.toLowerCase(Locale.ROOT);
+   boolean named=Character.isUpperCase(word.codePointAt(0))&&!OPENERS.contains(low);
+   boolean mixed=word.codePoints().skip(1).anyMatch(Character::isUpperCase);
+   if(named||mixed||Loanwords.protectedWord(low)||SpecialistWords670.known(low)||PhraseMemory.readyWord(low))result.merge(low,1,Integer::sum);
+  }
+  return result;
+ }
+}
