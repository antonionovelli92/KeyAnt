+   manifest.println("id\tname\tcollection\trequested_dark\teffective_dark\twidth\tsplit\tnumbers\tball\tlayer\tkeys\timage");
+   for(int index=0;index<ThemeCatalog.IDS.length;index++){
+    String id=ThemeCatalog.IDS[index];
+    Bitmap sheet=Bitmap.createBitmap(1600,1400,Bitmap.Config.ARGB_8888);Canvas out=new Canvas(sheet);out.drawColor(0xff242629);
+    Paint title=new Paint(3);title.setColor(Color.WHITE);title.setTextSize(20);out.drawText(id+" | "+ThemeCatalog.NAMES[index],12,24,title);
+    for(int mode=0;mode<2;mode++)for(int config=0;config<4;config++){
+     boolean requestedDark=mode==1,dark=ThemeCatalog.effectiveDark(id,requestedDark),split=config==3,numbers=config==2,ball=config==1;
+     int width=config>=2?760:400,layer=config==1?KeyboardId.ELEMENT_SYMBOLS:config==3?KeyboardId.ELEMENT_SYMBOLS_SHIFTED:KeyboardId.ELEMENT_ALPHABET;
