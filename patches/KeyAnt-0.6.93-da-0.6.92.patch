+@Composable internal fun ToolbarCoordinationControls693(showPreview:Boolean=true){
+ val c=LocalContext.current
+ fun refresh(){Settings.getInstance().loadSettings(c);KeyboardSwitcher.getInstance().setThemeNeedsReload()}
+ StudioCard{
+  Toggle("Coordina barra icone","toolbar_match_theme",ToolbarCoordination693.enabled(c),"Usa materiale e colori della tastiera attiva. Disattivando, torna la barra stock.",changed={refresh()})
