@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+
+import android.content.Context;
+import org.json.JSONObject;
+
+/** One policy for the live bar, samples, Maker and assistant. Explicit global choices win. */
+public final class ToolbarCoordination693 {
+ private ToolbarCoordination693(){}
+ public static boolean controlled(Context c,JSONObject draft){return KeyAntPrefs.get(c).contains("ka_toolbar_match_theme")||draft!=null&&draft.has("toolbar_match_theme");}
+ public static boolean enabled(Context c){return enabled(c,MakeKeyAnt.get(MakeKeyAnt.active()));}
+ public static boolean enabled(Context c,JSONObject draft){
+  var p=KeyAntPrefs.get(c);if(p.contains("ka_toolbar_match_theme"))return p.getBoolean("ka_toolbar_match_theme",false);
+  if(draft!=null&&draft.has("toolbar_match_theme"))return draft.optBoolean("toolbar_match_theme",false);
+  return (draft!=null?draft.optString("toolbar_look",KeyAntPrefs.text(c,"toolbar_look","current")):KeyAntPrefs.text(c,"toolbar_look","current")).equals("match_theme");
+ }
+ public static boolean iconsOnly(Context c){return iconsOnly(c,MakeKeyAnt.get(MakeKeyAnt.active()));}
+ public static boolean iconsOnly(Context c,JSONObject draft){
+  var p=KeyAntPrefs.get(c);return p.contains("ka_toolbar_theme_icons_only")?p.getBoolean("ka_toolbar_theme_icons_only",false):draft!=null&&draft.optBoolean("toolbar_theme_icons_only",false);
+ }
+ public static void manual(Context c,String look){
+  var edit=KeyAntPrefs.get(c).edit();
+  if(look.equals("match_theme"))edit.putBoolean("ka_toolbar_match_theme",true);
+  else if(look.equals("current"))edit.putBoolean("ka_toolbar_match_theme",false);
+  else edit.remove("ka_toolbar_match_theme");
+  edit.apply();
+ }
+}
