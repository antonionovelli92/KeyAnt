+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma
+import org.junit.*
+import org.junit.Assert.*
+import org.junit.runner.RunWith
+import org.robolectric.*
+import org.robolectric.annotation.*
+@RunWith(RobolectricTestRunner::class) @Config(sdk=[35],qualifiers="w400dp-h900dp-mdpi",shadows=[helium314.keyboard.ShadowInputMethodManager2::class])
+class KeyAntCoordination693Test {
+ private lateinit var ime:helium314.keyboard.latin.LatinIME
+ @After fun close(){ime.onDestroy()}
+ private val c get()=RuntimeEnvironment.getApplication()
+ @Before fun setup(){KeyAntPrefs.get(c).edit().clear().apply();ime=Robolectric.setupService(helium314.keyboard.latin.LatinIME::class.java)}
+ @Test fun assistantCommandsActivateCoordinateIconsAndRestoreStock(){
+  for(text in listOf("coordina la barra icone","attiva coordina barra icone","attiva la barra coordinata","abbina la barra al tema")){val request=AntSwitches.parse(text)!!;assertEquals("Coordina barra icone",request.target);AntSwitches.apply(c,request);assertTrue(ToolbarCoordination693.enabled(c))}
+  for(text in listOf("metti solo icone","attiva solo icone","voglio solo icone")){AntSwitches.apply(c,AntSwitches.parse(text)!!);assertTrue(ToolbarCoordination693.iconsOnly(c));assertTrue(ToolbarCoordination693.enabled(c))}
+  for(text in listOf("ripristina la barra stock","disattiva coordina barra icone","non coordinare la barra")){AntSwitches.apply(c,AntSwitches.parse(text)!!);assertFalse(ToolbarCoordination693.enabled(c))}
+  assertNull(AntSwitches.parse("come attivo la barra coordinata?"))
+ }
+ @Test fun guideAndSearchPointToTheActualControls(){
+  for(text in listOf("come coordino la barra icone?","voglio solo icone senza tasti","dove torno alla barra stock?")){val guide=AntGuide.answer(c,text);assertTrue(guide.links.any{it.title=="Coordina barra icone"});assertTrue(guide.links.any{it.title=="Solo icone coordinate"})}
+  assertTrue(SettingsSearch.search("coordina barra icone",c).any{it.title=="Coordina barra icone"})
+ }
+ @Test fun makerCommandsKeepTheRequestedBarPolicy(){
+  val model=AntMaker.build(c,"crea un tema Smalto con barra coordinata e solo icone");assertTrue(model.optBoolean("toolbar_match_theme"));assertTrue(model.optBoolean("toolbar_theme_icons_only"));
+  assertTrue(AntMaker.canRefine("barra stock"));val stock=AntMaker.build(c,"barra stock",model);assertFalse(stock.optBoolean("toolbar_match_theme"));assertEquals("current",stock.optString("toolbar_look"))
+ }
+}
