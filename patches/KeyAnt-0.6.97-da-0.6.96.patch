+@Composable internal fun ProfileRange697(profile:String,field:String,label:String,default:Int,min:Int,max:Int,revision:Int,save:(Int)->Unit){
+ val c=LocalContext.current
+ var amount by remember(profile,field,revision){mutableFloatStateOf(DimensionProfiles697.value(c,profile,field,default).coerceIn(min,max).toFloat())}
