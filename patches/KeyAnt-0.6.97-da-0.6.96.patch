+/** A read-time override. Turning it off restores personal settings without any copy/overwrite. */
+public final class ThemeEffects697 {
+ private ThemeEffects697(){}
+ public static boolean enabled(Context c,String profile){
+  var draft=MakeKeyAnt.get(profile);if(profile!=null&&profile.startsWith("preview_")&&draft!=null&&draft.has("nativeTouch"))return draft.optBoolean("nativeTouch");return KeyAntPrefs.bool(c,"theme_touch_effects",draft!=null&&draft.optBoolean("nativeTouch"));
+ }
+ public static String description(String profile){
+  if(MakeKeyAnt.is(profile))return "Risposta e corsa definite nella creazione Maker";
+  if(ReferenceCollection691.scoop(profile))return "Pressione meccanica · incavo e spalla del tasto";
+  if(ReferenceCollection691.enamel(profile))return "Pressione morbida · rilievo satinato";
+  if(profile.equals("glass")||LiquidMaterial.family(profile))return "Pressione e riflessi del materiale in vetro";
+  return "Risposta originale del materiale · senza effetti personali aggiunti";
+ }
