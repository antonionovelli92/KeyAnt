@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma
+import android.content.Context
+import helium314.keyboard.latin.settings.Settings
+import helium314.keyboard.keyboard.KeyboardLayoutSet
+import helium314.keyboard.keyboard.KeyboardSwitcher
+
+/** Explicit bounded local commands. Never interprets a question or a vague amount as an edit. */
+internal object AntSizing697 {
+ fun submit(c:Context,text:String,previous:AntDialog.Turn?):AntDialog.Turn?{
+  val q=SettingsSearch.normal(text)
+  if(!Regex("^(?:(?:ant|mi|puoi|potresti|per favore|ok) )*(?:imposta|porta|metti|regola|cambia) ").containsMatchIn(q)||text.trimEnd().endsWith("?")&&!q.startsWith("puoi "))return null
+  val amount=Regex("\\b(\\d{1,3})\\b").find(q)?.value?.toInt()?:return null
+  val dimensional=Regex("larghezza|altezza|dimensione|diametro").containsMatchIn(q)
+  if(!dimensional)return null
+  val current=DimensionProfiles697.current(c)
+  val wide=when{ "aperto" in q->true;"chiuso" in q||"telefono" in q->false;else->current.startsWith("wide") }
+  if("fold" in q&&!DimensionProfiles697.foldable(c))return AntDialog.Turn(text,"Su questo dispositivo non è disponibile un profilo Fold. Puoi regolare Telefono verticale e orizzontale.",target="Dimensioni",page="size")
+  val landscape=when{"orizzontale" in q->true;"verticale" in q->false;else->current.contains("landscape")}
+  val ball=when{"senza trackball" in q||"senza sfera" in q->false;"trackball" in q||"sfera" in q||"pallina" in q->true;else->current.endsWith("_ball")}
+  val profile=(if(wide)"wide" else "compact")+"_"+(if(landscape)"landscape" else "portrait")+(if(ball)"_ball" else "")
+  val group=when{ "spaziatrice" in q->"space";"funzion" in q->"functions";"numer" in q->"numbers";"simbol" in q->"punctuation";else->"letters" }
+  val field:String;val min:Int;val max:Int;val title:String
+  when{
+   "diametro" in q->{field="ball_size";min=48;max=100;title="Diametro trackball · dp"}
+   "altezza" in q&&Regex("inferiore|quinta|comandi").containsMatchIn(q)->{field="bottom_height";min=65;max=130;title="Altezza riga inferiore · %"}
+   "altezza base" in q||"altezza righe" in q->{field="row";min=32;max=80;title="Altezza base delle righe · dp"}
+   "copritast" in q->{field=group+if("larghezza" in q)"_width" else "_height";min=55;max=100;title="Dimensione copritasti · %"}
+   "dimensione" in q&&Regex("letter|simbol|scritt|icon").containsMatchIn(q)->{field=group+"_ink";min=70;max=135;title="Dimensione lettere e simboli · %"}
+   "larghezza" in q&&Regex("riga|letter|funzion|spaziatrice|numer").containsMatchIn(q)->{field="section_"+if(Regex("inferiore|quinta|comandi").containsMatchIn(q))"bottom" else group;min=60;max=100;title="Larghezza sezione · %"}
+   "larghezza" in q&&"struttura" in q->{field="width";min=60;max=100;title="Larghezza della struttura · %"}
+   "larghezza" in q&&"tastiera" in q->{field="outer_width";min=60;max=100;title="Larghezza complessiva · %"}
+   "altezza" in q&&"tastiera" in q->{field="height";min=70;max=130;title="Altezza complessiva · %"}
+   else->return null
+  }
+  if(amount !in min..max)return AntDialog.Turn(text,"Per $title scegli un valore da $min a $max. Non ho modificato il profilo.",target="Dimensioni",page="size")
+  KeyAntPrefs.get(c).edit().putInt(DimensionProfiles697.key(profile,field),amount).apply()
+  Settings.getInstance().loadSettings(c);KeyboardLayoutSet.onKeyboardThemeChanged();KeyboardSwitcher.getInstance().setThemeNeedsReload()
+  return AntDialog.Turn(text,"$title: $amount. Profilo: "+DimensionProfiles697.label(profile)+". Gli altri profili restano invariati.",target="Dimensioni",page="size")
+ }
+}
