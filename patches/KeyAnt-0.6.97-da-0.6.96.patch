diff --git a/app/src/main/java/helium314/keyboard/keyforma/DimensionProfiles697.java b/app/src/main/java/helium314/keyboard/keyforma/DimensionProfiles697.java
new file mode 100644
index 0000000..5a95f20
--- /dev/null
+++ b/app/src/main/java/helium314/keyboard/keyforma/DimensionProfiles697.java
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+import android.content.*;
+import android.content.res.Configuration;
+import android.graphics.Canvas;
+import android.hardware.Sensor;
+import android.hardware.SensorManager;
+/** Independent orientation/display profiles; trackball values inherit until explicitly edited. */
+public final class DimensionProfiles697 {
+ private DimensionProfiles697(){}
+ private static Context application;
+ public static int heightForResources(android.content.res.Resources res,int row,boolean numbers){
+  if(application==null||KeyAntPrefs.bool(application,"floating",false))return KeyboardGeometry.bodyHeight(res.getDisplayMetrics().density,row,numbers);
+  Configuration x=res.getConfiguration();String profile=resolve(x.screenWidthDp,x.screenHeightDp,x.orientation==Configuration.ORIENTATION_LANDSCAPE,KeyAntPrefs.bool(application,"magic_ball",false));
+  int percent=Math.max(70,Math.min(130,value(application,profile,"height",100)));return Math.round(res.getDisplayMetrics().density*(row*(numbers?5:4)*percent/100f+8));
+ }
+ public static boolean foldable(Context c){
+  SensorManager sensors=c.getSystemService(SensorManager.class);
+  String model=android.os.Build.MODEL.toLowerCase(java.util.Locale.ROOT);
+  return c.getPackageManager().hasSystemFeature("android.hardware.sensor.hinge_angle") ||
+   android.os.Build.VERSION.SDK_INT>=30&&sensors!=null&&sensors.getDefaultSensor(Sensor.TYPE_HINGE_ANGLE)!=null ||
+   model.contains("fold")||model.startsWith("sm-f9");
+ }
+ public static String resolve(int width,int height,boolean landscape,boolean ball){
+  return (Math.min(width,height)>=600?"wide":"compact")+(landscape?"_landscape":"_portrait")+(ball?"_ball":"");
+ }
+ public static String current(Context c){application=c.getApplicationContext();Configuration x=c.getResources().getConfiguration();return resolve(x.screenWidthDp,x.screenHeightDp,x.orientation==Configuration.ORIENTATION_LANDSCAPE,KeyAntPrefs.bool(c,"magic_ball",false));}
+ public static String key(String profile,String field){return "ka_dim_"+profile+"_"+field;}
+ private static boolean legacyWide(String profile){return profile.startsWith("wide")||profile.contains("landscape");}
+ public static String base(String profile){return profile.replace("_ball","");}
+ public static int value(Context c,String profile,String field,int fallback){return value(KeyAntPrefs.get(c),profile,field,fallback);}
+ public static int value(SharedPreferences p,String profile,String field,int fallback){
+  String key=key(profile,field);if(p.contains(key))return p.getInt(key,fallback);
+  return p.getInt(key(base(profile),field),fallback);
+ }
+ public static String splitKey(Context c){return key(base(current(c)),"split");}
+ public static boolean split(Context c){return split(c,current(c));}
+ public static boolean split(Context c,String profile){return KeyAntPrefs.get(c).getBoolean(key(base(profile),"split"),KeyAntPrefs.bool(c,legacyWide(profile)?"split_wide":"split_compact",false));}
+ public static int row(Context c,String profile,String theme){
+  Configuration config=c.getResources().getConfiguration();int width=legacyWide(profile)?700:Math.min(config.screenWidthDp,config.screenHeightDp);if(width<200)width=400;
+  int fallback=theme.equals(SmokeGlassCaps.ID)?50:ReferenceCollection691.defaultRowHeight(theme,width);
+  SharedPreferences p=KeyAntPrefs.get(c);
+  fallback=p.getInt(legacyWide(profile)?"ka_row_wide":"ka_row_compact",fallback);var draft=MakeKeyAnt.get(theme);if(draft!=null)fallback=draft.optInt("height",fallback);
+  return Math.max(32,Math.min(80,value(p,profile,"row",fallback)));
+ }
+ public static int height(Context c,String profile,int row,boolean numbers){
+  int percent=Math.max(70,Math.min(130,value(c,profile,"height",100)));
+  return Math.round(c.getResources().getDisplayMetrics().density*(row*(numbers?5:4)*percent/100f+8));
+ }
+ public static int outerWidth(Context c,String profile,int available){return Math.max(1,Math.round(available*Math.max(60,Math.min(100,value(c,profile,"outer_width",100)))/100f));}
+ public static int padding(Context c,String profile,int width,int natural){
+  SharedPreferences p=KeyAntPrefs.get(c);String field=key(profile,"width"),parent=key(base(profile),"width");
+  if(!p.contains(field)&&!p.contains(parent))return natural;
+  float fraction=Math.max(60,Math.min(100,value(p,profile,"width",100)))/100f;
+  return Math.max(Math.round(3*c.getResources().getDisplayMetrics().density),Math.round(width*(1-fraction)/2));
+ }
+ public static int section(Context c,String profile,String group){
+  int legacy=KeyAntPrefs.number(c,"section_"+(legacyWide(profile)?"wide":"compact")+"_"+group,100);
+  return Math.max(60,Math.min(100,value(c,profile,"section_"+group,legacy)));
+ }
+ public static float shape(Context c,String profile,int code,String axis){return Math.max(55,Math.min(100,value(c,profile,MakerGeometry.group(code)+"_"+axis,100)))/100f;}
+ public static float ink(Context c,String profile,int code){return Math.max(70,Math.min(135,value(c,profile,MakerGeometry.group(code)+"_ink",100)))/100f;}
+ public static void transform(Context c,Canvas canvas,String profile,int code,float w,float h){canvas.scale(shape(c,profile,code,"width"),shape(c,profile,code,"height"),w/2,h/2);}
+ public static void reset(Context c,String profile){SharedPreferences p=KeyAntPrefs.get(c);SharedPreferences.Editor e=p.edit();String prefix=key(profile,"");for(String key:p.getAll().keySet())if(key.startsWith(prefix)&&(!key.startsWith(prefix+"ball_")||profile.endsWith("_ball")))e.remove(key);e.apply();}
+ public static String label(String p){return (p.startsWith("wide")?"Schermo ampio":"Telefono")+" · "+(p.contains("landscape")?"orizzontale":"verticale")+(p.endsWith("_ball")?" · trackball":"");}
+}
