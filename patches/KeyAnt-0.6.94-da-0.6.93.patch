+++ b/app/src/main/java/helium314/keyboard/keyforma/ThemeRgb694.java
@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+import android.content.Context;
+/** One command for the theme selector and ANT. Off preserves the saved effect and palette. */
+public final class ThemeRgb694 {
+ private ThemeRgb694(){}
+ public static void coordinate(Context c,String profile){
+  var edit=KeyAntPrefs.get(c).edit().putBoolean("ka_rgb_enabled",true)
+   .putString("ka_rgb_setting_profile",profile).putString("ka_rgb_color_choice","theme");
+  if(KeyAntPrefs.text(c,"rgb","off").equals("off"))edit.putString("ka_rgb","fixed");
+  if(KeyAntPrefs.number(c,"rgb_intensity",70)<=0)edit.putInt("ka_rgb_intensity",70);
+  edit.apply();
+ }
+ public static void off(Context c){KeyAntPrefs.get(c).edit().putBoolean("ka_rgb_enabled",false).putString("ka_rgb_setting_profile",SearchTheme.active(c)).apply();}
+ public static boolean coordinated(Context c){return !KeyEffects.effectiveMode(c).equals("off")&&KeyAntPrefs.text(c,"rgb_color_choice","").equals("theme");}
+}
