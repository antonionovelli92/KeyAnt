+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+import android.content.Context;
+import android.content.res.ColorStateList;
+import android.graphics.Color;
+import android.graphics.drawable.*;
+import android.view.*;
+import android.widget.*;
+/** Fixed icon band and two-line caption band. Glyph effects cannot shift neighbouring captions. */
+final class ToolPanelTile694 extends FrameLayout {
+ final ImageView icon;final TextView caption;
+ private int dp(float x){return Math.round(x*getResources().getDisplayMetrics().density);}
+ static int height(Context c,String size,boolean icons){
+  TextView measure=new TextView(c);measure.setTextSize(size.equals("compact")?11:12);measure.setIncludeFontPadding(false);
+  int lines=measure.getLineHeight()*2;
+  float d=c.getResources().getDisplayMetrics().density;
+  return Math.max(Math.round((size.equals("compact")?68:size.equals("large")?100:84)*d),lines+Math.round((icons?46:16)*d));
+ }
+ ToolPanelTile694(Context c,String id,int ink,int back,String size,boolean icons){super(c);
+  setTag("tool-tile:"+id);setContentDescription(ToolCatalog.label(id));setFocusable(true);
+  setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_YES);
+  GradientDrawable shape=new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,new int[]{ToolSurface.mix(back,ink,.075f),ToolSurface.mix(back,ink,.025f)});
+  shape.setCornerRadius(dp(12));shape.setStroke(Math.max(1,dp(.5f)),ToolSurface.mix(back,ink,.15f));
+  GradientDrawable mask=new GradientDrawable();mask.setColor(Color.WHITE);mask.setCornerRadius(dp(12));
+  setBackground(new RippleDrawable(ColorStateList.valueOf((ink&0xffffff)|0x22000000),shape,mask));
+  caption=new TextView(c);caption.setText(ToolCatalog.label(id));caption.setTextSize(size.equals("compact")?11:12);caption.setTextColor(ink);caption.setIncludeFontPadding(false);caption.setMaxLines(2);caption.setEllipsize(android.text.TextUtils.TruncateAt.END);caption.setGravity(Gravity.CENTER);caption.setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
+  icon=new ImageView(c);icon.setScaleType(ImageView.ScaleType.CENTER);icon.setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
+  icon.setImageDrawable(ToolbarLook.icon(c,id,ink,dp(size.equals("compact")?20:23)));
+  // Reuse the exact toolbar material, including stock and icons-only coordination.
+  if(ToolbarLook.enabled(c))ToolSurface.applyToolbar(icon,ink,back);
+  icon.setVisibility(icons?VISIBLE:GONE);
+  LinearLayout content=new LinearLayout(c);content.setOrientation(LinearLayout.VERTICAL);content.setGravity(Gravity.CENTER);content.setPadding(dp(4),dp(4),dp(4),dp(4));
+  content.addView(icon,new LinearLayout.LayoutParams(-1,dp(36)));
+  LinearLayout.LayoutParams textParams=new LinearLayout.LayoutParams(-1,caption.getLineHeight()*2);textParams.topMargin=icons?dp(2):0;
+  content.addView(caption,textParams);addView(content,new LayoutParams(-1,-2,Gravity.CENTER));
+ }
+}
