@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+import java.util.regex.*;
+/** Local grammatical boundaries, not a dictionary of the user's particular reminders. */
+final class EventLanguage671 {
+ private static final String TOKEN="KEYANTTITLEMARKER";
+ private static final Pattern NAME=Pattern.compile("(?iu)\\b(?:chiamat[oa]|intitolat[oa]|dal titolo|con (?:il )?titolo|titolo\\s*:)\\s*[\"“«]?(.+?)(?=[\"”»]|\\s+(?:(?:in|a)\\s+(?:via|vja|viale|piazza|corso|largo)\\b|presso\\b|indirizzo\\b|alle\\s+\\d|ore\\s+\\d|(?:il|per il)\\s+\\d|domani\\b|dopodomani\\b|dalle\\b|per\\s+\\d+\\s+(?:ore|minuti|giorni))|$)");
+ private static final Pattern QUOTED=Pattern.compile("[\"“«]([^\"”»]+)[\"”»]");
+ record Protected(String text,String title,boolean explicit) {
+  String restore(String clean){return title==null?clean:explicit&&clean.contains(TOKEN)?title:clean.replace(TOKEN,title);}
+ }
+ static Protected protect(String text){
+  var literal=Pattern.compile("(?iu)\\b(?:chiamat[oa]|intitolat[oa]|dal titolo|con (?:il )?titolo|titolo\\s*:)\\s*[\"“«]([^\"”»]+)[\"”»]").matcher(text);
+  if(literal.find())return new Protected(text.substring(0,literal.start())+TOKEN+text.substring(literal.end()),literal.group(1).trim(),true);
+  var named=NAME.matcher(text);if(named.find())return new Protected(text.substring(0,named.start())+TOKEN+text.substring(named.end()).replaceFirst("^[\"”»]",""),named.group(1).trim(),true);
+  var quoted=QUOTED.matcher(text);if(quoted.find())return new Protected(text.substring(0,quoted.start())+TOKEN+text.substring(quoted.end()),quoted.group(1),false);
+  return new Protected(text,null,false);
+ }
+ static String locationSpelling(String text){return text.replaceAll("(?iu)\\b(in|a)\\s+vja\\b","$1 via");}
+ static String title(String text){
+  String clean=text.replaceAll("\\s+"," ").replaceAll("^[\\s,;:–-]+|[\\s,;:–-]+$","");
+  // A command linker before an infinitive is not part of the action's name.
+  // Preserve Di Maggio, di sera, di lavoro and every internal preposition.
+  return clean.replaceFirst("(?iu)^di\\s+(?=[\\p{L}]+(?:are|ere|ire)(?:mi|ti|si|ci|vi|lo|la|li|le|ne)?\\b)","");
+ }
+}
