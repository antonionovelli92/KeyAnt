+package helium314.keyboard.keyforma;
+import java.time.*;import org.junit.Test;import static org.junit.Assert.*;
+public class KeyAntLanguage671Test {
+ final ZonedDateTime now=ZonedDateTime.of(2026,11,6,12,0,0,0,ZoneId.of("Europe/Rome"));
+ @Test public void naturalReminderLinkersWorkBeforeAndAfterTime(){for(String phrase:new String[]{"ricordami di entrare su discord domani alle 15:30","ricordami domani alle 15:30 di entrare su discord","ricordami tra 20 minuti di entrare su discord","promemoria di entrare su discord domani alle 15:30"}){var action=ContextAction651.parse(phrase);assertNotNull(phrase,action);assertEquals(phrase,"entrare su discord",EventDetails657.parse(action.text(),now).title());}}
+ @Test public void meaningfulPrepositionsAndNamesArePreserved(){for(String title:new String[]{"Di Maggio e amici","di sera al museo","lezione di inglese","comprare il libro di fisica","Di Pietro"})assertEquals(title,EventDetails657.parse(title+" domani alle 17",now).title());}
+ @Test public void namedTitleLocationTypoAndDefaultDuration(){var d=EventDetails657.parse("di maggio, 5 luglio alle 17 chiamato Pieraccioni and Friends in vja parco dei Medici",now);assertEquals("Pieraccioni and Friends",d.title());assertEquals("via parco dei Medici",d.place());assertEquals(60,d.minutes());assertTrue(d.valid());assertEquals(7,ContextAction651.date("5 luglio alle 17 chiamato Pieraccioni and Friends",now).getMonthValue());}
+ @Test public void quotedNamesCannotBecomeDatesOrAddresses(){String text="domani alle 17 chiamato \"Domenica in via Roma\" presso Teatro Centrale per 90 minuti";var d=EventDetails657.parse(text,now);assertEquals("Domenica in via Roma",d.title());assertEquals("Teatro Centrale",d.place());assertEquals(90,d.minutes());assertEquals(now.toLocalDate().plusDays(1),ContextAction651.date(text,now).toLocalDate());assertEquals("Di mangiare la carne",EventDetails657.parse("domani alle 17 chiamato \"Di mangiare la carne\"",now).title());}
+ @Test public void titleCanPrecedeSchedule(){var d=EventDetails657.parse("chiamato Serata di giochi domani alle 20 in via Roma 12 per 2 ore",now);assertEquals("Serata di giochi",d.title());assertEquals("via Roma 12",d.place());assertEquals(120,d.minutes());}
+ @Test public void properNameAfterTriggerIsNotACommandLinker(){var a=ContextAction651.parse("ricordami Di Maggio domani alle 17");assertEquals("Di Maggio",EventDetails657.parse(a.text(),now).title());}
+ @Test public void conflictingDatesRequireReview(){assertNull(ContextAction651.date("visita 5 luglio oppure 6 luglio alle 17",now));}
+ @Test public void vagueAndInvalidTimesRequireReview(){assertNull(ContextAction651.date("entrare su discord un giorno di questi",now));assertNull(ContextAction651.date("entrare su discord 31 febbraio alle 17",now));assertNull(ContextAction651.date("entrare su discord domani alle 27",now));}
+}
