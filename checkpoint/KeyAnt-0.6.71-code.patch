@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: GPL-3.0-only
+package helium314.keyboard.keyforma;
+import android.content.Context;import android.graphics.*;import java.io.*;
+/** Detailed full-longitude portrait albedos. The same mipmapped sphere is used in Maker and IME. */
+final class PortraitMaps671 {
+ static boolean supports(String id){return id.equals("piddu_kitty")||id.equals("piddu_kuromi")||id.equals("piddu_melody")||id.equals("head_luffy")||id.equals("head_takemichi")||id.equals("head_hinata")||id.equals("head_naruto")||id.equals("head_deku")||id.equals("head_allmight");}
+ static Bitmap create(Context context,String id)throws IOException{
+  try(InputStream stream=context.getAssets().open("ball_portraits/"+id+".png")){
+   Bitmap source=BitmapFactory.decodeStream(stream);if(source==null)throw new IOException("Invalid portrait "+id);
+   int w=1024,h=512;Bitmap target=Bitmap.createBitmap(w,h,Bitmap.Config.ARGB_8888);Canvas c=new Canvas(target);Paint paint=new Paint(Paint.ANTI_ALIAS_FLAG|Paint.FILTER_BITMAP_FLAG);
+   // Renderer longitude increases from screen right to left. Preserve asymmetric
+   // facial marks by reversing U; front is pi/2 (u=.75), source front u=.5.
+   c.scale(-1,1);
+   c.drawBitmap(source,null,new RectF(-w*1.25f,0,-w*.25f,h),paint);
+   c.drawBitmap(source,null,new RectF(-w*.25f,0,w*.75f,h),paint);source.recycle();
+   return target;
+  }
+ }
+}
